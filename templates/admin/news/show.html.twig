{% extends 'base.html.twig' %}

{% block title %}{{ news.titre }} - Admin{% endblock %}

{% block content %}
<div class="container mx-auto px-6 py-8 max-w-2xl">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-white">{{ news.titre }}</h1>
        <a href="{{ path('app_admin_dash_news') }}" class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded-lg font-bold hover:bg-[#B8941F] transition">Back to News</a>
    </div>

    <div class="bg-[#12121a] rounded-xl border border-[#D4AF37]/10 p-8">
        {% if news.image and news.image != 'default-news.jpg' %}
            <img src="{{ asset('uploads/news/' ~ news.image) }}" alt="{{ news.titre }}" class="w-full h-64 object-cover rounded-lg mb-6">
        {% else %}
            <img src="{{ asset('assets/images/zz.png') }}" alt="{{ news.titre }}" class="w-full h-64 object-cover rounded-lg mb-6 opacity-80">
        {% endif %}
        
        <div class="mb-6">
            <p class="text-sm text-gray-400">Category: <span class="text-[#D4AF37]">{{ news.categorie }}</span></p>
            <p class="text-sm text-gray-400">Published: <span class="text-[#D4AF37]">{{ news.datePublication|date('M d, Y H:i') }}</span></p>
        </div>

        <div class="prose prose-invert max-w-none mb-8 text-gray-300 whitespace-pre-wrap">
            {{ news.contenu }}
        </div>

        <div class="flex gap-3">
            <a href="{{ path('app_admin_news_edit', {'newsId': news.newsId}) }}" class="px-4 py-2 bg-blue-500/10 text-blue-500 rounded-lg hover:bg-blue-500/20 transition">Edit</a>
            <a href="{{ path('app_admin_dash_news') }}" class="px-4 py-2 bg-gray-600/20 text-gray-400 rounded-lg hover:bg-gray-600/30 transition">Back</a>
        </div>
    </div>
</div>
{% endblock %}
