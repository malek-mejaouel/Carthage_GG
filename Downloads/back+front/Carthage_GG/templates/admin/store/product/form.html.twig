{% extends 'base.html.twig' %}
{% block title %}{{ is_edit ? 'Edit' : 'New' }} Product{% endblock %}
{% block content %}
<div class="container mx-auto px-4 py-8 max-w-3xl">
    <h1 class="text-2xl font-bold text-[#D4AF37] mb-6">{{ is_edit ? 'Edit' : 'New' }} Product</h1>
    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="mb-4 px-4 py-2 rounded {{ type == 'success' ? 'bg-green-600/20 text-green-300 border border-green-600/40' : 'bg-red-600/20 text-red-300 border border-red-600/40' }}">
                {{ msg }}
            </div>
        {% endfor %}
    {% endfor %}
    {{ form_start(form) }}
        <div class="grid md:grid-cols-2 gap-4">
            <div class="md:col-span-2">
                {{ form_label(form.name) }}
                {{ form_widget(form.name, {'attr': {'class': 'w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}
                {{ form_errors(form.name) }}
            </div>
            <div class="md:col-span-2">
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {'attr': {'class': 'w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}
                {{ form_errors(form.description) }}
            </div>
            <div>
                {{ form_label(form.price) }}
                {{ form_widget(form.price, {'attr': {'class': 'w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}
                {{ form_errors(form.price) }}
            </div>
            <div>
                {{ form_label(form.discount) }}
                {{ form_widget(form.discount, {'attr': {'class': 'w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}
                {{ form_errors(form.discount) }}
            </div>
            <div>
                {{ form_label(form.stock) }}
                {{ form_widget(form.stock, {'attr': {'class': 'w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}
                {{ form_errors(form.stock) }}
            </div>
            <div>
                {{ form_label(form.sku) }}
                {{ form_widget(form.sku, {'attr': {'class': 'w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}
                {{ form_errors(form.sku) }}
            </div>
            <div class="md:col-span-2">
                {{ form_label(form.image) }}
                {{ form_widget(form.image, {'attr': {'class': 'w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}
                {{ form_errors(form.image) }}
            </div>
            <div>
                {{ form_label(form.averageRating) }}
                {{ form_widget(form.averageRating, {'attr': {'class': 'w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}
                {{ form_errors(form.averageRating) }}
            </div>
            <div class="flex items-center gap-2">
                {{ form_widget(form.isFeatured) }} {{ form_label(form.isFeatured) }}
                {{ form_errors(form.isFeatured) }}
            </div>
            <div>
                {{ form_label(form.status) }}
                {{ form_widget(form.status, {'attr': {'class': 'w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}
                {{ form_errors(form.status) }}
            </div>
            <div class="md:col-span-2">
                {{ form_label(form.category) }}
                {{ form_widget(form.category, {'attr': {'class': 'w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}
                {{ form_errors(form.category) }}
            </div>
        </div>
        <div class="mt-6 flex gap-4">
            <button class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded hover:bg-[#B8941F]">Save</button>
            <a href="{{ path('admin_products_index') }}" class="px-4 py-2 border border-[#D4AF37]/30 rounded text-gray-300">Cancel</a>
            <a href="{{ path('app_admin_dash_products') }}" class="px-4 py-2 border border-[#D4AF37]/40 text-[#D4AF37] rounded hover:bg-[#D4AF37]/10">Products Dashboard</a>
        </div>
    {{ form_end(form) }}
    <div class="mt-4 text-sm text-gray-300">
        <span>Final price:</span>
        <span id="final-price" class="ml-2 font-semibold text-green-400">$0.00</span>
    </div>
    <script>
        (function() {
            const priceInput = document.getElementById('{{ form.price.vars.id }}');
            const discountInput = document.getElementById('{{ form.discount.vars.id }}');
            const finalEl = document.getElementById('final-price');
            function calc() {
                const price = parseFloat((priceInput?.value || '').replace(',', '.')) || 0;
                let disc = parseFloat((discountInput?.value || '').replace(',', '.')) || 0;
                if (disc < 0) disc = 0;
                if (disc > 100) disc = 100;
                const final = Math.max(0, price * (1 - disc / 100));
                finalEl.textContent = '$' + final.toFixed(2);
            }
            priceInput && priceInput.addEventListener('input', calc);
            discountInput && discountInput.addEventListener('input', calc);
            calc();
        })();
    </script>
{% endblock %}
