<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ game.getName() }} - CarthageGG</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .btn-primary {
            background: linear-gradient(to right, #D4AF37, #B8941F);
            color: #0a0a0f;
        }
        .btn-primary:hover {
            opacity: 0.9;
        }
    </style>
</head>
<body class="bg-[#0a0a0f] text-[#e4e4e7] min-h-screen">
    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 border-b border-[#D4AF37]/20 bg-[#0a0a0f]/95 backdrop-blur-sm">
        <div class="container mx-auto px-4">
            <div class="flex h-16 items-center justify-between">
                <a href="{{ path('app_index') }}" class="flex items-center space-x-2">
                    <img src="{{ asset('assets/images/zz.png') }}" alt="CarthageGG Logo" class="h-14 w-14 rounded-lg shadow-lg object-cover">
                    <span class="text-2xl font-bold text-[#D4AF37]">Carthage</span>
                    <span class="text-2xl font-bold text-white">GG</span>
                </a>
                <div class="hidden md:flex items-center space-x-1">
                    <a href="{{ path('tournament_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Tournaments</a>
                    <a href="{{ path('team_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Teams</a>
                    <a href="{{ path('match_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Matches</a>
                    <a href="{{ path('match_player_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">MatchPlayer</a>
                    <a href="{{ path('team_player_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">TeamPlayer</a>
                    <a href="{{ path('game_index') }}" class="px-4 py-2 rounded-md bg-[#D4AF37]/20 text-[#D4AF37] hover:bg-[#D4AF37]/30">Game</a>
                </div>
                <div class="flex items-center space-x-3">
                    <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-white px-4 py-2 text-sm font-medium">Login</a>
                    <a href="{{ path('app_dashboard') }}" class="px-4 py-2 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] text-sm font-medium">Dashboard</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-8">
        <!-- Header Section -->
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-4xl font-bold text-[#D4AF37] mb-2">{{ game.getName() }}</h1>
                    <p class="text-gray-400">Game Details</p>
                </div>
                <div class="flex space-x-3">
                    <a href="{{ path('game_index') }}" class="inline-flex items-center px-6 py-3 rounded-md border-2 border-[#D4AF37] text-[#D4AF37] font-medium hover:bg-[#D4AF37]/10 transition-colors">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        Back to List
                    </a>
                   
                </div>
            </div>
        </div>

        <!-- Game Details Card -->
        <div class="max-w-4xl mx-auto">
            <div class="bg-[#12121a] border border-[#D4AF37]/20 rounded-lg p-8 mb-8">
                <div class="grid md:grid-cols-3 gap-8">
                    <!-- Left Column: Basic Info -->
                    <div class="md:col-span-2">
                        <div class="mb-6">
                            <h2 class="text-2xl font-bold text-[#D4AF37] mb-4">Game Information</h2>
                            <div class="space-y-4">
                                <div class="flex items-center">
                                    <div class="w-32 text-[#D4AF37] font-medium">Game ID</div>
                                    <div class="flex-1">
                                        <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-[#D4AF37]/10 text-[#D4AF37] font-bold">
                                            {{ game.getGameId() }}
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="flex items-start">
                                    <div class="w-32 text-[#D4AF37] font-medium">Name</div>
                                    <div class="flex-1 text-xl font-bold">{{ game.getName() }}</div>
                                </div>
                                
                                <div class="flex items-center">
                                    <div class="w-32 text-[#D4AF37] font-medium">Genre</div>
                                    <div class="flex-1">
                                        <span class="px-4 py-2 rounded-full bg-[#D4AF37]/10 text-[#D4AF37] font-medium">
                                            {{ game.getGenre() }}
                                        </span>
                                    </div>
                                </div>
                                
                                {% if game.description is defined and game.description is not empty %}
                                <div class="flex items-start">
                                    <div class="w-32 text-[#D4AF37] font-medium">Description</div>
                                    <div class="flex-1">
                                        <div class="bg-[#0a0a0f] border border-[#D4AF37]/20 rounded-lg p-4">
                                            <p class="text-gray-300">{{ game.description }}</p>
                                        </div>
                                    </div>
                                </div>
                                {% endif %}
                                
                                {% if game.releaseYear is defined %}
                                <div class="flex items-center">
                                    <div class="w-32 text-[#D4AF37] font-medium">Release Year</div>
                                    <div class="flex-1">{{ game.releaseYear }}</div>
                                </div>
                                {% endif %}
                                
                                {% if game.createdAt is defined %}
                                <div class="flex items-center">
                                    <div class="w-32 text-[#D4AF37] font-medium">Created</div>
                                    <div class="flex-1">{{ game.createdAt|date('F j, Y') }}</div>
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    
                        <div class="border-t border-[#D4AF37]/20 pt-6">
                            <h3 class="text-lg font-bold text-[#D4AF37] mb-4">Quick Actions</h3>
                            <div class="space-y-3">
                                <a href="{{ path('game_edit', {id: game.getGameId()}) }}" 
                                   class="w-full flex items-center justify-center px-4 py-3 rounded-md bg-[#D4AF37]/10 text-[#D4AF37] hover:bg-[#D4AF37]/20 transition-colors">
                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                    </svg>
                                    Edit Game
                                </a>
                                
                                <a href="{{ path('game_index') }}" 
                                   class="w-full flex items-center justify-center px-4 py-3 rounded-md border border-[#D4AF37]/20 text-[#D4AF37] hover:bg-[#D4AF37]/10 transition-colors">
                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
                                    </svg>
                                    View All Games
                                </a>
                                
                                <form method="post" action="{{ path('game_delete', {id: game.getGameId()}) }}" 
                                      onsubmit="return confirm('Are you sure you want to delete this game? This action cannot be undone.');"
                                      class="w-full">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ game.getGameId()) }}">
                                    <button type="submit" 
                                            class="w-full flex items-center justify-center px-4 py-3 rounded-md bg-red-500/20 text-red-400 hover:bg-red-500/30 transition-colors">
                                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                        Delete Game
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Similar Games Section -->
            <div class="bg-[#12121a] border border-[#D4AF37]/20 rounded-lg p-6 mb-8">
                <h3 class="text-xl font-bold text-[#D4AF37] mb-4">🎮 Similar Games</h3>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    {% set popularGames = [
                        { name: 'Counter-Strike 2', genre: 'FPS' },
                        { name: 'VALORANT', genre: 'FPS' },
                        { name: 'League of Legends', genre: 'MOBA' },
                        { name: 'Dota 2', genre: 'MOBA' },
                        { name: 'Fortnite', genre: 'Battle Royale' },
                        { name: 'Apex Legends', genre: 'Battle Royale' },
                        { name: 'Rocket League', genre: 'Sports' },
                        { name: 'Rainbow Six Siege', genre: 'FPS' }
                    ] %}
                    
                    {% for similar in popularGames|filter(similar => similar.genre == game.getGenre() and similar.name != game.getName())|slice(0, 4) %}
                    <div class="border border-[#D4AF37]/20 rounded-lg p-4 text-center hover:border-[#D4AF37]/50 transition-colors">
                        <div class="text-lg font-bold">{{ similar.name }}</div>
                        <div class="text-sm text-gray-400">{{ similar.genre }}</div>
                    </div>
                    {% else %}
                    <div class="col-span-4 text-center text-gray-400 py-4">
                        No similar games found in the same genre.
                    </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Additional Information -->
            <div class="bg-[#12121a] border border-[#D4AF37]/20 rounded-lg p-6">
                <h3 class="text-xl font-bold text-[#D4AF37] mb-4">ℹ️ About This Game</h3>
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <h4 class="font-medium text-gray-300 mb-2">Game Management</h4>
                        <p class="text-sm text-gray-400">
                            Games are the foundation of tournaments on CarthageGG. Each game can host multiple tournaments, matches, and teams.
                            Make sure game information is accurate and up-to-date for the best competitive experience.
                        </p>
                    </div>
                    <div>
                        <h4 class="font-medium text-gray-300 mb-2">Tournament Compatibility</h4>
                        <p class="text-sm text-gray-400">
                            This game can be selected when creating new tournaments. Ensure genre classification is correct
                            for proper tournament categorization and player matchmaking.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-[#D4AF37]/20 bg-[#0a0a0f] mt-16">
        <div class="container mx-auto px-4 py-8">
            <div class="text-center text-gray-400 text-sm">
                <p>&copy; 2026 CarthageGG. All rights reserved.</p>
                <p class="mt-2">Tunisia's Premier Esports Platform</p>
            </div>
        </div>
    </footer>

    <script>
        // Add confirmation for delete action
        document.addEventListener('DOMContentLoaded', function() {
            const deleteForm = document.querySelector('form[onsubmit*="confirm"]');
            if (deleteForm) {
                deleteForm.onsubmit = function(e) {
                    return confirm('Are you sure you want to delete this game? This will permanently remove it from the system and may affect existing tournaments. This action cannot be undone.');
                };
            }
        });
    </script>
</body>
</html>