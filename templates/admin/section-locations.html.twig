<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Locations | CarthageGG</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="{{ asset('assets/styles/admin.css') }}">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
    </head>
<body class="bg-[#0a0a0f] text-[#e4e4e7]">
    {% include 'admin/_sidebar.html.twig' %}
    <div class="lg:ml-64 flex flex-col min-h-screen">
        <main class="flex-1 p-6">
            <div class="container mx-auto px-6 py-8">
                <div class="flex items-center justify-between mb-6">
                    <h1 class="text-2xl font-bold text-white">Locations</h1>
                    <a href="{{ path('app_admin_dashboard') }}" class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded-lg font-bold hover:bg-[#B8941F] transition">Back to Dashboard</a>
                </div>
                <div class="bg-[#12121a] rounded-xl border border-[#D4AF37]/10 overflow-hidden">
                    <div class="p-6 border-b border-[#D4AF37]/10 flex justify-between items-center">
                        <h3 class="text-lg font-bold text-white">All Locations</h3>
                        <div class="flex gap-2">
                            <a href="{{ path('location_new') }}" class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded-lg text-sm font-bold hover:bg-[#B8941F] transition">Add Location</a>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm text-gray-400">
                            <thead class="bg-[#1a1a24] text-[#D4AF37] uppercase font-bold text-xs">
                                <tr>
                                    <th class="px-6 py-4">ID</th>
                                    <th class="px-6 py-4">Name</th>
                                    <th class="px-6 py-4">Address</th>
                                    <th class="px-6 py-4">Capacity</th>
                                    <th class="px-6 py-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[#D4AF37]/10">
                                {% for l in locations %}
                                <tr class="table-row-hover transition">
                                    <td class="px-6 py-4 font-medium text-white">{{ l.id }}</td>
                                    <td class="px-6 py-4">{{ l.name }}</td>
                                    <td class="px-6 py-4">{{ l.address ?: '' }}</td>
                                    <td class="px-6 py-4">{{ l.capacity ?: '' }}</td>
                                    <td class="px-6 py-4">
                                        <a href="{{ path('location_detail', {'id': l.id}) }}" class="px-3 py-1 border border-[#D4AF37] text-[#D4AF37] rounded text-xs mr-2">View</a>
                                        <a href="{{ path('location_edit', {'id': l.id}) }}" class="px-3 py-1 border border-[#D4AF37] text-[#D4AF37] rounded text-xs mr-2">Edit</a>
                                        <a href="{{ path('location_delete', {'id': l.id}) }}" onclick="return confirm('Delete?')" class="px-3 py-1 border border-red-500 text-red-500 rounded text-xs">Delete</a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td class="px-6 py-4" colspan="5">No locations</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <script src="{{ asset('assets/js/admin-dashboard.js') }}"></script>
</body>
</html>
