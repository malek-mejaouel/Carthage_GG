<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Leaderboard - CarthageGG</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="{{ asset('assets/styles/styles.css') }}" />
</head>
<body class="bg-[#0a0a0f] text-[#e4e4e7]">
    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 border-b border-[#D4AF37]/20 bg-[#0a0a0f]/95 backdrop-blur-sm">
        <div class="container mx-auto px-4">
            <div class="flex h-16 items-center justify-between">
                <a href="{{ path('app_index') }}" class="flex items-center space-x-2">
                    <img src="{{ asset('assets/images/zz.png') }}" alt="CarthageGG Logo" class="h-14 w-14 rounded-lg shadow-lg object-cover">
                    <span class="text-2xl font-bold text-[#D4AF37]">Carthage</span>
                    <span class="text-2xl font-bold text-white">GG</span>
                </a>
                <div class="hidden md:flex items-center space-x-1">
                    <a href="{{ path('app_tournaments') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Tournaments</a>
                    <a href="{{ path('app_teams') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Teams</a>
                    <a href="{{ path('app_matches') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Matches</a>
                    <a href="{{ path('app_leaderboard') }}" class="px-4 py-2 rounded-md bg-[#D4AF37]/10 text-[#D4AF37]">Leaderboard</a>
                    <a href="{{ path('app_support') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Support</a>
                </div>
                <div class="flex items-center space-x-3">
                    <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-white px-4 py-2 text-sm font-medium">Login</a>
                    <a href="{{ path('app_admin_dashboard') }}" class="px-4 py-2 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] text-sm font-medium">Dashboard</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <div class="container mx-auto px-4 py-12">
        <h1 class="text-4xl font-bold mb-4">Global Leaderboard</h1>
        <p class="text-gray-400">See where you rank among the best players and teams in Tunisia</p>
    </div>

    <!-- Tabs -->
    <div class="container mx-auto px-4">
        <div class="flex border-b border-[#D4AF37]/20 mb-8">
            <button class="tab-button active px-6 py-4 font-medium text-[#D4AF37] border-b-2 border-[#D4AF37]">Teams</button>
            <button class="tab-button px-6 py-4 font-medium text-gray-400 border-b-2 border-transparent hover:border-[#D4AF37]/50">Players</button>
            <button class="tab-button px-6 py-4 font-medium text-gray-400 border-b-2 border-transparent hover:border-[#D4AF37]/50">Points</button>
        </div>

        <!-- Teams Leaderboard -->
        <div class="mb-12 overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-[#D4AF37]/20">
                        <th class="px-4 py-4 font-semibold text-gray-400">Rank</th>
                        <th class="px-4 py-4 font-semibold text-gray-400">Team</th>
                        <th class="px-4 py-4 font-semibold text-gray-400">Wins</th>
                        <th class="px-4 py-4 font-semibold text-gray-400">Losses</th>
                        <th class="px-4 py-4 font-semibold text-gray-400">Win Rate</th>
                        <th class="px-4 py-4 font-semibold text-gray-400">Points</th>
                        <th class="px-4 py-4 font-semibold text-gray-400">Region</th>
                    </tr>
                </thead>
                <tbody>
                {% if standings is defined and standings|length > 0 %}
                    {% for teamData in standings %}
                        <tr class="border-b border-[#D4AF37]/10 hover:bg-[#12121a] transition-colors">
                            <td class="px-4 py-4">
                                <span class="font-bold {% if loop.index == 1 %}text-[#D4AF37]{% else %}text-gray-400{% endif %} text-lg">
                                    {{ loop.index }}
                                </span>
                            </td>
                            <td class="px-4 py-4 font-bold">{{ teamData.team.teamName }}</td>
                            <td class="px-4 py-4">{{ teamData.wins }}</td>
                            <td class="px-4 py-4">{{ teamData.losses }}</td>
                            <td class="px-4 py-4"><span class="text-[#D4AF37] font-bold">{{ teamData.winRate }}%</span></td>
                            <td class="px-4 py-4"><span class="font-bold">{{ teamData.points }}</span></td>
                            <td class="px-4 py-4">{{ teamData.team.region ?? 'Tunisia' }}</td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="7" class="px-4 py-8 text-center text-gray-400">
                            No teams found.
                        </td>
                    </tr>
                {% endif %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-[#D4AF37]/20 bg-[#0a0a0f] mt-16">
        <div class="container mx-auto px-4 py-12">
            <div class="grid md:grid-cols-4 gap-8 mb-8">
                <div>
                    <h3 class="font-bold text-[#D4AF37] mb-4">CarthageGG</h3>
                    <p class="text-gray-400 text-sm">Tunisia's premier esports platform</p>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Platform</h4>
                    <ul class="space-y-2 text-gray-400 text-sm">
                        <li><a href="{{ path('app_tournaments') }}" class="hover:text-[#D4AF37]">Tournaments</a></li>
                        <li><a href="{{ path('app_teams') }}" class="hover:text-[#D4AF37]">Teams</a></li>
                        <li><a href="{{ path('app_matches') }}" class="hover:text-[#D4AF37]">Matches</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Compete</h4>
                    <ul class="space-y-2 text-gray-400 text-sm">
                        <li><a href="{{ path('app_leaderboard') }}" class="hover:text-[#D4AF37]">Leaderboard</a></li>
                        <li><a href="{{ path('app_register') }}" class="hover:text-[#D4AF37]">Register</a></li>
                        <li><a href="{{ path('app_support') }}" class="hover:text-[#D4AF37]">Support</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Follow</h4>
                    <div class="flex space-x-4">
                        <a href="#" class="text-gray-400 hover:text-[#D4AF37]">Twitter</a>
                        <a href="#" class="text-gray-400 hover:text-[#D4AF37]">Discord</a>
                        <a href="#" class="text-gray-400 hover:text-[#D4AF37]">YouTube</a>
                    </div>
                </div>
            </div>
            <div class="border-t border-[#D4AF37]/20 pt-8 text-center text-gray-400 text-sm">
                <p>&copy; 2026 CarthageGG. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="{{ asset('assets/main.js') }}"></script>
</body>
</html>