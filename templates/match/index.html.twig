{% extends "base.html.twig" %}

{% block title %}Matches - CarthageGG{% endblock %}
{% block content %}
<section class="py-12 px-6 bg-gradient-to-b from-[#0a0a0f] to-[#1a1a24]">
    <div class="container mx-auto max-w-6xl">
        <div class="mb-12">
            <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Matches</h1>
            <p class="text-lg text-gray-400">Browse recent and upcoming matches</p>
        </div>

        <div class="bg-[#12121a] rounded-xl border border-[#D4AF37]/10 overflow-hidden">
            <div class="p-6 border-b border-[#D4AF37]/10 flex justify-between items-center">
                <h3 class="text-lg font-bold text-white">All Matches</h3>
                {% set totalPages = (total / perPage)|round(0, 'ceil') %}
                <div class="text-sm text-gray-400">Page {{ page }} of {{ totalPages }}</div>
            </div>

            {% if matches|length > 0 %}
                <div class="divide-y divide-[#D4AF37]/10">
                    {% for match in matches %}
                        <div class="p-6 grid grid-cols-1 md:grid-cols-5 gap-4 items-center">
                            <div class="md:col-span-2">
                                <div class="text-white font-semibold">
                                    {{ match.teamA ? match.teamA.teamName : 'TBD' }}
                                    <span class="text-gray-500">vs</span>
                                    {{ match.teamB ? match.teamB.teamName : 'TBD' }}
                                </div>
                                <div class="text-sm text-gray-400">
                                    {{ match.tournament ? match.tournament.tournamentName : 'Friendly' }}
                                </div>
                            </div>
                            <div class="text-[#D4AF37] font-bold">
                                {{ match.scoreTeamA is not null ? match.scoreTeamA : '-' }}
                                <span class="text-gray-500">:</span>
                                {{ match.scoreTeamB is not null ? match.scoreTeamB : '-' }}
                            </div>
                            <div class="text-sm text-gray-400">
                                {{ match.matchDate ? match.matchDate|date('M d, Y - H:i') : 'TBD' }}
                            </div>
                            <div class="text-right">
                                <a href="{{ path('match_show', {'id': match.matchId}) }}" class="px-3 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded-lg text-sm font-bold hover:bg-[#B8941F] transition">Details</a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="p-6 text-center text-gray-400">No matches found</div>
            {% endif %}

            <div class="p-6 flex justify-between items-center">
                <a href="{{ path('match_index', {'page': page > 1 ? page - 1 : 1}) }}" class="px-4 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded hover:border-[#D4AF37] transition font-bold {{ page <= 1 ? 'pointer-events-none opacity-50' : '' }}">Previous</a>
                <a href="{{ path('match_index', {'page': page < totalPages ? page + 1 : totalPages}) }}" class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded hover:bg-[#B8941F] transition font-bold {{ page >= totalPages ? 'pointer-events-none opacity-50' : '' }}">Next</a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
