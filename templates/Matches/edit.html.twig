<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ match.tournament ? match.tournament.tournamentName : 'Match' }} - CarthageGG</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="{{ asset('assets/styles/styles.css') }}" />
</head>
<body class="bg-[#0a0a0f] text-[#e4e4e7] min-h-screen">

    {# Navigation Bar #}
    <nav class="sticky top-0 z-50 border-b border-[#D4AF37]/20 bg-[#0a0a0f]/95 backdrop-blur-sm">
        <div class="container mx-auto px-4">
            <div class="flex h-16 items-center justify-between">
                <a href="{{ path('app_index') }}" class="flex items-center space-x-2">
                    <img src="{{ asset('assets/images/zz.png') }}" alt="CarthageGG Logo" class="h-14 w-14 rounded-lg shadow-lg object-cover">
                    <span class="text-2xl font-bold text-[#D4AF37]">Carthage</span>
                    <span class="text-2xl font-bold text-white">GG</span>
                </a>
                <div class="hidden md:flex items-center space-x-1">
                    <a href="{{ path('tournament_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Tournaments</a>
                    <a href="{{ path('team_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Teams</a>
                    <a href="{{ path('match_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Matches</a>
                    <a href="{{ path('match_player_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">MatchPlayers</a>
                    <a href="{{ path('team_player_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">TeamPlayers</a>
                    <a href="{{ path('game_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Games</a>
                </div>
                <div class="flex items-center space-x-3">
                    <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-white px-4 py-2 text-sm font-medium">Login</a>
                    <a href="{{ path('app_dashboard') }}" class="px-4 py-2 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] text-sm font-medium">Dashboard</a>
                </div>
            </div>
        </div>
    </nav>

    {# Page Header #}
    <div class="container mx-auto px-4 py-8">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-4xl font-bold mb-2">Match Details</h1>
                <p class="text-gray-400">{{ match.tournament ? match.tournament.tournamentName : 'Match Information' }}</p>
            </div>
            <div class="flex space-x-2">
                <a href="{{ path('match_edit', {id: match.matchId}) }}" class="px-6 py-2 rounded-md bg-[#D4AF37]/10 text-[#D4AF37] font-medium hover:bg-[#D4AF37]/20">Edit</a>
                <a href="{{ path('match_index') }}" class="px-6 py-2 rounded-md border border-gray-400 text-gray-300 hover:bg-[#1e1e2e] font-medium">Back to List</a>
            </div>
        </div>

        {# Match Information Card #}
        <div class="border border-[#D4AF37]/20 rounded-lg bg-[#12121a] p-6 mb-8">
            <div class="h-2 bg-gradient-to-r from-[#D4AF37] to-[#B8941F] mb-6 rounded-t-lg"></div>

            {# Match Teams #}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center mb-8">
                <div class="text-center p-4 rounded-lg bg-[#0a0a0f]">
                    <div class="text-sm text-gray-400 mb-2">Team A</div>
                    <div class="text-xl font-bold mb-2">
                        {{ match.teamA ? match.teamA.teamName : 'TBD' }}
                    </div>
                    <div class="text-3xl font-bold text-[#D4AF37]">{{ match.scoreTeamA ?? '0' }}</div>
                </div>
                <div class="text-center">
                    <div class="inline-block px-4 py-2 rounded-full bg-[#D4AF37]/20 text-[#D4AF37] font-bold">VS</div>
                </div>
                <div class="text-center p-4 rounded-lg bg-[#0a0a0f]">
                    <div class="text-sm text-gray-400 mb-2">Team B</div>
                    <div class="text-xl font-bold mb-2">
                        {{ match.teamB ? match.teamB.teamName : 'TBD' }}
                    </div>
                    <div class="text-3xl font-bold text-[#D4AF37]">{{ match.scoreTeamB ?? '0' }}</div>
                </div>
            </div>

            {# Match Details Grid #}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
                {# Game accessed via tournament #}
                {% if match.tournament and match.tournament.game %}
                    <div class="bg-[#0a0a0f] rounded-lg p-4">
                        <div class="text-gray-400 text-sm mb-1">Game</div>
                        <div class="font-bold">{{ match.tournament.game.name }}</div>
                    </div>
                {% endif %}

                {% if match.tournament %}
                    <div class="bg-[#0a0a0f] rounded-lg p-4">
                        <div class="text-gray-400 text-sm mb-1">Tournament</div>
                        <div class="font-bold">{{ match.tournament.tournamentName }}</div>
                    </div>
                {% endif %}

                <div class="bg-[#0a0a0f] rounded-lg p-4">
                    <div class="text-gray-400 text-sm mb-1">Match Date</div>
                    <div class="font-bold">{{ match.matchDate ? match.matchDate|date('Y-m-d H:i') : 'Not Scheduled' }}</div>
                </div>

                <div class="bg-[#0a0a0f] rounded-lg p-4">
                    <div class="text-gray-400 text-sm mb-1">Status</div>
                    <div class="font-bold">
                        {% if match.scoreTeamA is not null and match.scoreTeamB is not null %}
                            <span class="text-green-400">Completed</span>
                        {% else %}
                            <span class="text-yellow-400">Upcoming</span>
                        {% endif %}
                    </div>
                </div>

                <div class="bg-[#0a0a0f] rounded-lg p-4">
                    <div class="text-gray-400 text-sm mb-1">Match ID</div>
                    <div class="font-bold text-[#D4AF37]">#{{ match.matchId }}</div>
                </div>
            </div>

            {# Actions #}
            <div class="flex gap-2 pt-6 border-t border-[#D4AF37]/20">
                <a href="{{ path('match_edit', {id: match.matchId}) }}" class="flex-1 px-4 py-2 rounded-md bg-[#D4AF37]/10 text-[#D4AF37] hover:bg-[#D4AF37]/20 text-sm font-medium text-center">Edit Match</a>
                <a href="{{ path('match_index') }}" class="flex-1 px-4 py-2 rounded-md border border-gray-400 text-gray-300 hover:bg-[#1e1e2e] text-sm font-medium text-center">Back to Matches</a>
                <form method="post" action="{{ path('match_delete', {id: match.matchId}) }}" style="flex: 1" onsubmit="return confirm('Are you sure you want to delete this match?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ match.matchId) }}">
                    <button type="submit" class="w-full px-4 py-2 rounded-md border border-red-600 text-red-600 hover:bg-red-600/10 text-sm font-medium">Delete Match</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>