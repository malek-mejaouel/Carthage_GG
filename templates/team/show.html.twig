<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ team.getTeamName() }} - CarthageGG</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="{{ asset('assets/styles/styles.css') }}" />
</head>
<body class="bg-[#0a0a0f] text-[#e4e4e7]">
    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 border-b border-[#D4AF37]/20 bg-[#0a0a0f]/95 backdrop-blur-sm">
        <div class="container mx-auto px-4">
            <div class="flex h-16 items-center justify-between">
                <a href="{{ path('app_index') }}" class="flex items-center space-x-2">
                    <img src="{{ asset('assets/images/zz.png') }}" alt="CarthageGG Logo" class="h-14 w-14 rounded-lg shadow-lg object-cover">
                    <span class="text-2xl font-bold text-[#D4AF37]">Carthage</span>
                    <span class="text-2xl font-bold text-white">GG</span>
                </a>
                <div class="hidden md:flex items-center space-x-1">
                    <a href="{{ path('tournament_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Tournaments</a>
                    <a href="{{ path('team_index') }}" class="px-4 py-2 rounded-md bg-[#D4AF37]/10 text-[#D4AF37]">Teams</a>
                    <a href="{{ path('match_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Matches</a>
                    <a href="{{ path('match_player_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">MatchPlayers</a>
                    <a href="{{ path('team_player_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">TeamPlayers</a>
                    <a href="{{ path('game_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Games</a>
                </div>
                <div class="flex items-center space-x-3">
                    <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-white px-4 py-2 text-sm font-medium">Login</a>
                    <a href="{{ path('app_dashboard') }}" class="px-4 py-2 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] text-sm font-medium">Dashboard</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <div class="container mx-auto px-4 py-12">
        <div class="flex items-center space-x-4 mb-8">
            <a href="{{ path('team_index') }}" class="text-gray-400 hover:text-white">← Back to Teams</a>
        </div>
    </div>

    <!-- Team Details -->
    <div class="container mx-auto px-4 pb-12">
        <div class="max-w-3xl mx-auto">
            <div class="border border-[#D4AF37]/20 rounded-lg bg-[#12121a] overflow-hidden">
                <!-- Gradient Bar -->
                <div class="h-2 bg-gradient-to-r from-[#D4AF37] to-[#B8941F]"></div>

                <!-- Content -->
                <div class="p-8">
                    <!-- Header -->
                    <div class="flex items-start gap-6 mb-8">
                        {% if team.getLogo() %}
                            <img src="{{ team.getLogo() }}" alt="Logo" class="w-24 h-24 rounded-lg object-cover flex-shrink-0">
                        {% else %}
                            <div class="w-24 h-24 rounded-lg bg-[#1e1e2e] flex items-center justify-center">
                                <span class="text-gray-400 text-xs">No Logo</span>
                            </div>
                        {% endif %}
                        <div class="flex-1">
                            <h1 class="text-4xl font-bold mb-2">{{ team.getTeamName() }}</h1>
                            <p class="text-gray-400 mb-3">Team ID #{{ team.getTeamId() }}</p>
                            <div class="text-sm">
                                <span class="inline-block px-3 py-1 rounded-full bg-[#D4AF37]/20 text-[#D4AF37] font-bold">{{ team.getTeamPlayers()|length }} Members</span>
                            </div>
                        </div>
                    </div>

                    <!-- Info Grid -->
                    <div class="grid grid-cols-2 gap-4 mb-8 border-t border-[#D4AF37]/10 pt-8">
                        <div>
                            <div class="text-gray-400 text-xs font-semibold mb-1">OWNER</div>
                            <div class="text-lg font-bold">{{ team.getUser() ? team.getUser().getUsername() : 'N/A' }}</div>
                        </div>
                        <div>
                            <div class="text-gray-400 text-xs font-semibold mb-1">CREATED</div>
                            <div class="text-lg font-bold">{{ team.getCreationDate() ? team.getCreationDate()|date('Y-m-d') : 'N/A' }}</div>
                        </div>
                    </div>

                    <!-- Members Section -->
                    <div class="mb-8 border-t border-[#D4AF37]/10 pt-8">
                        <h3 class="text-xl font-bold mb-4">Team Members</h3>
                        {% if team.getTeamPlayers()|length > 0 %}
                            <div class="space-y-2">
                                {% for member in team.getTeamPlayers() %}
                                    <div class="flex items-center justify-between bg-[#0a0a0f] rounded-lg p-3">
                                        <span class="font-medium">{{ member.getUser().getUsername() }}</span>
                                        <span class="text-gray-400 text-xs">Member</span>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="text-center py-6 bg-[#0a0a0f] rounded-lg">
                                <p class="text-gray-400">No members yet</p>
                            </div>
                        {% endif %}
                    </div>

                    <!-- Actions -->
                    <div class="flex gap-3">
                        <a href="{{ path('team_edit', {id: team.getTeamId()}) }}" class="flex-1 px-4 py-2 rounded-lg bg-[#D4AF37]/10 text-[#D4AF37] hover:bg-[#D4AF37]/20 font-medium text-center">Edit Team</a>
                        <form method="post" action="{{ path('team_delete', {id: team.getTeamId()}) }}" style="flex: 1" onsubmit="return confirm('Delete this team? This action cannot be undone.');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ team.getTeamId()) }}">
                            <button type="submit" class="w-full px-4 py-2 rounded-lg border border-red-600 text-red-600 hover:bg-red-600/10 font-medium">Delete Team</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
