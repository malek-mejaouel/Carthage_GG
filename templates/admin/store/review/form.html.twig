{% extends 'base.html.twig' %}
{% block title %}{{ is_edit ? 'Edit' : 'New' }} Review{% endblock %}
{% block content %}
<div class="container mx-auto px-4 py-8 max-w-3xl">
    <h1 class="text-2xl font-bold text-[#D4AF37] mb-6">{{ is_edit ? 'Edit' : 'New' }} Review</h1>
    {{ form_start(form) }}
        <div class="grid md:grid-cols-2 gap-4">
            <div class="md:col-span-2">{{ form_label(form.product) }}{{ form_widget(form.product, {'attr': {'class': 'w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}</div>
            <div class="md:col-span-2">{{ form_label(form.user) }}{{ form_widget(form.user, {'attr': {'class': 'w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}</div>
            <div>{{ form_label(form.rating) }}{{ form_widget(form.rating, {'attr': {'class': 'w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}</div>
            <div class="md:col-span-2">{{ form_label(form.comment) }}{{ form_widget(form.comment, {'attr': {'class': 'w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}</div>
        </div>
        <div class="mt-6 flex gap-4">
            <button class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded hover:bg-[#B8941F]">Save</button>
            <a href="{{ path('admin_reviews_index') }}" class="px-4 py-2 border border-[#D4AF37]/30 rounded text-gray-300">Cancel</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
