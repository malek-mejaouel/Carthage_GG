<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Games - CarthageGG</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom styles to match CarthageGG theme */
        .btn-primary {
            background: linear-gradient(to right, #D4AF37, #B8941F);
            color: #0a0a0f;
        }
        .btn-primary:hover {
            opacity: 0.9;
        }
        .btn-secondary {
            background-color: #D4AF37/10;
            color: #D4AF37;
            border: 1px solid #D4AF37/20;
        }
        .btn-secondary:hover {
            background-color: #D4AF37/20;
        }
    </style>
</head>
<body class="bg-[#0a0a0f] text-[#e4e4e7] min-h-screen">
    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 border-b border-[#D4AF37]/20 bg-[#0a0a0f]/95 backdrop-blur-sm">
        <div class="container mx-auto px-4">
            <div class="flex h-16 items-center justify-between">
                <a href="{{ path('app_index') }}" class="flex items-center space-x-2">
                    <img src="{{ asset('assets/images/zz.png') }}" alt="CarthageGG Logo" class="h-14 w-14 rounded-lg shadow-lg object-cover">
                    <span class="text-2xl font-bold text-[#D4AF37]">Carthage</span>
                    <span class="text-2xl font-bold text-white">GG</span>
                </a>
                <div class="hidden md:flex items-center space-x-1">
                    <a href="{{ path('tournament_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Tournaments</a>
                    <a href="{{ path('team_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Teams</a>
                    <a href="{{ path('match_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Matches</a>
                    <a href="{{ path('match_player_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">MatchPlayers</a>
                    <a href="{{ path('team_player_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">TeamPlayers</a>
                    <a href="{{ path('game_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Games</a>
                </div>
                <div class="flex items-center space-x-3">
                    <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-white px-4 py-2 text-sm font-medium">Login</a>
                    <a href="{{ path('app_dashboard') }}" class="px-4 py-2 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] text-sm font-medium">Dashboard</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-8">
        <!-- Header Section -->
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-4xl font-bold text-[#D4AF37] mb-2">Games Management</h1>
                    <p class="text-gray-400">Manage all games available for tournaments</p>
                </div>
                <a href="{{ path('game_new') }}" class="inline-flex items-center px-6 py-3 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] font-medium hover:opacity-90 transition-opacity">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Create New Game
                </a>
            </div>
            <div class="mt-4">
                <a href="{{ path('app_index') }}" class="text-[#D4AF37] hover:underline flex items-center">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    Back to site
                </a>
            </div>
        </div>

        <!-- Search and Sort Controls -->
        <div class="flex justify-between items-center mb-6">
            <div class="text-2xl font-bold">All Games</div>
            <div class="flex space-x-2">
                <!-- Search Input -->
                <div class="relative">
                    <input type="text" 
                           id="gameSearch" 
                           placeholder="Search games..." 
                           class="pl-10 pr-4 py-2 rounded-md bg-[#12121a] border border-[#D4AF37]/30 text-white text-sm w-64 focus:outline-none focus:border-[#D4AF37]">
                    <svg class="w-5 h-5 absolute left-3 top-2.5 text-gray-400" 
                         fill="none" 
                         stroke="currentColor" 
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round" 
                              stroke-linejoin="round" 
                              stroke-width="2" 
                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
                
                <!-- Sort Dropdown -->
                <select id="sortSelect" class="px-4 py-2 rounded-md bg-[#12121a] border border-[#D4AF37]/30 text-white text-sm">
                    
                    <option value="name_asc">Name (A-Z)</option>
                    <option value="name_desc">Name (Z-A)</option>
                    <option value="genre_asc">Genre (A-Z)</option>
                    <option value="genre_desc">Genre (Z-A)</option>
                </select>
            </div>
        </div>

        <!-- Games Table -->
        <div class="bg-[#12121a] border border-[#D4AF37]/20 rounded-lg overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="bg-[#1a1a24] border-b border-[#D4AF37]/20">
                            <th class="py-4 px-6 text-left text-[#D4AF37] font-semibold">ID</th>
                            <th class="py-4 px-6 text-left text-[#D4AF37] font-semibold">Name</th>
                            <th class="py-4 px-6 text-left text-[#D4AF37] font-semibold">Genre</th>
                            <th class="py-4 px-6 text-left text-[#D4AF37] font-semibold">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="gamesContainer">
                    {% for g in games %}
                        <tr class="game-row border-b border-[#D4AF37]/10 hover:bg-[#1a1a24]/50 transition-colors"
                            data-id="{{ g.getGameId() }}"
                            data-name="{{ g.getName()|lower }}"
                            data-genre="{{ g.getGenre()|lower }}">
                            <td class="py-4 px-6">
                                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-[#D4AF37]/10 text-[#D4AF37] font-bold">
                                    {{ g.getGameId() }}
                                </span>
                            </td>
                            <td class="py-4 px-6 font-medium">{{ g.getName() }}</td>
                            <td class="py-4 px-6">
                                <span class="px-3 py-1 rounded-full text-xs font-medium bg-[#D4AF37]/10 text-[#D4AF37]">
                                    {{ g.getGenre() }}
                                </span>
                            </td>
                            <td class="py-4 px-6">
                                <div class="flex items-center space-x-2">
                                    <a href="{{ path('game_show', {id: g.getGameId()}) }}" 
                                       class="px-3 py-1 rounded-md bg-blue-500/20 text-blue-400 hover:bg-blue-500/30 text-sm font-medium transition-colors flex items-center space-x-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                        <span>View</span>
                                    </a>
                                    <a href="{{ path('game_edit', {id: g.getGameId()}) }}" 
                                       class="px-3 py-1 rounded-md bg-[#D4AF37]/10 text-[#D4AF37] hover:bg-[#D4AF37]/20 text-sm font-medium transition-colors flex items-center space-x-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                        <span>Edit</span>
                                    </a>
                                    <form method="post" action="{{ path('game_delete', {id: g.getGameId()}) }}" 
                                          style="display:inline" 
                                          onsubmit="return confirm('Are you sure you want to delete this game?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ g.getGameId()) }}">
                                        <button type="submit" 
                                                class="px-3 py-1 rounded-md bg-red-500/20 text-red-400 hover:bg-red-500/30 text-sm font-medium transition-colors flex items-center space-x-1">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                            </svg>
                                            <span>Delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr id="noGamesRow">
                            <td colspan="4" class="py-8 px-6 text-center text-gray-400">
                                <div class="flex flex-col items-center justify-center">
                                    <svg class="w-12 h-12 text-gray-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    <p class="text-lg">No games found</p>
                                    <p class="text-sm">Create your first game to get started</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- No Results Message -->
        <div id="noResults" class="text-center py-12 hidden">
            <p class="text-gray-400 mb-4">No games found matching your search</p>
            <button id="clearSearch" class="px-6 py-2 rounded-md bg-[#D4AF37]/10 text-[#D4AF37] font-medium hover:bg-[#D4AF37]/20">
                Clear Search
            </button>
        </div>

        <!-- Pagination Info -->
        {% if total is defined %}
        <div class="mt-6 p-4 bg-[#12121a] border border-[#D4AF37]/20 rounded-lg">
            <div class="flex items-center justify-between">
                <div class="text-gray-400">
                    <span class="text-[#D4AF37] font-bold">{{ total }}</span> total games
                </div>
                <div class="text-gray-400">
                    Page <span class="text-[#D4AF37] font-bold">{{ page }}</span>
                </div>
            </div>
        </div>
        {% endif %}

       
            
        </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-[#D4AF37]/20 bg-[#0a0a0f] mt-16">
        <div class="container mx-auto px-4 py-8">
            <div class="text-center text-gray-400 text-sm">
                <p>&copy; 2026 CarthageGG. All rights reserved.</p>
                <p class="mt-2">Tunisia's Premier Esports Platform</p>
            </div>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Search and Sort functionality
            const searchInput = document.getElementById('gameSearch');
            const sortSelect = document.getElementById('sortSelect');
            const gameRows = document.querySelectorAll('.game-row');
            const gamesContainer = document.getElementById('gamesContainer');
            const noResults = document.getElementById('noResults');
            const clearSearch = document.getElementById('clearSearch');
            const noGamesRow = document.getElementById('noGamesRow');

            // Function to filter and sort games
            function updateGames() {
                const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';
                const sortValue = sortSelect ? sortSelect.value : 'id_asc';
                
                let rows = Array.from(gameRows);
                
                // Filter by search term
                if (searchTerm) {
                    rows = rows.filter(row => {
                        const name = row.getAttribute('data-name') || '';
                        const genre = row.getAttribute('data-genre') || '';
                        return name.includes(searchTerm) || genre.includes(searchTerm);
                    });
                }
                
                // Sort the rows
                rows.sort((a, b) => {
                    switch(sortValue) {
                        case 'id_asc':
                            // ID Low to High
                            const idA = parseInt(a.getAttribute('data-id') || 0);
                            const idB = parseInt(b.getAttribute('data-id') || 0);
                            return idA - idB;
                            
                        case 'id_desc':
                            // ID High to Low
                            const idA_desc = parseInt(a.getAttribute('data-id') || 0);
                            const idB_desc = parseInt(b.getAttribute('data-id') || 0);
                            return idB_desc - idA_desc;
                            
                        case 'name_asc':
                            // Name A-Z
                            const nameA = a.getAttribute('data-name') || '';
                            const nameB = b.getAttribute('data-name') || '';
                            return nameA.localeCompare(nameB);
                            
                        case 'name_desc':
                            // Name Z-A
                            const nameA_desc = a.getAttribute('data-name') || '';
                            const nameB_desc = b.getAttribute('data-name') || '';
                            return nameB_desc.localeCompare(nameA_desc);
                            
                        case 'genre_asc':
                            // Genre A-Z
                            const genreA = a.getAttribute('data-genre') || '';
                            const genreB = b.getAttribute('data-genre') || '';
                            return genreA.localeCompare(genreB);
                            
                        case 'genre_desc':
                            // Genre Z-A
                            const genreA_desc = a.getAttribute('data-genre') || '';
                            const genreB_desc = b.getAttribute('data-genre') || '';
                            return genreB_desc.localeCompare(genreA_desc);
                            
                        default:
                            return 0;
                    }
                });
                
                // Update visibility and order
                let visibleCount = 0;
                
                // First hide all rows
                gameRows.forEach(row => {
                    row.style.display = 'none';
                });
                
                // Then show and reorder visible rows
                rows.forEach(row => {
                    row.style.display = 'table-row';
                    gamesContainer.appendChild(row);
                    visibleCount++;
                });
                
                // Show/hide no results message
                if (visibleCount === 0) {
                    if (searchTerm) {
                        // Search returned no results
                        if (noResults) noResults.classList.remove('hidden');
                        if (noGamesRow) noGamesRow.style.display = 'none';
                        if (gamesContainer) gamesContainer.style.display = 'none';
                    } else {
                        // No games at all (initial empty state)
                        if (noGamesRow) noGamesRow.style.display = 'table-row';
                        if (noResults) noResults.classList.add('hidden');
                        if (gamesContainer) gamesContainer.style.display = 'table-row-group';
                    }
                } else {
                    // Has results
                    if (noResults) noResults.classList.add('hidden');
                    if (noGamesRow) noGamesRow.style.display = 'none';
                    if (gamesContainer) gamesContainer.style.display = 'table-row-group';
                }
            }
            
            // Event listeners
            if (searchInput) {
                searchInput.addEventListener('input', updateGames);
            }
            
            if (sortSelect) {
                sortSelect.addEventListener('change', updateGames);
            }
            
            if (clearSearch) {
                clearSearch.addEventListener('click', function() {
                    if (searchInput) searchInput.value = '';
                    updateGames();
                });
            }
            
            // Initialize
            updateGames();
        });
    </script>
</body>
</html>