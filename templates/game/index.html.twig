{% extends "base.html.twig" %}

{% block title %}Tournament - CarthageGG{% endblock %}
{% block content %}

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-8">
        <!-- Header Section -->
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-4xl font-bold text-[#D4AF37] mb-2">Games Management</h1>
                    <p class="text-gray-400">Manage all games available for tournaments</p>
                </div>
                {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('game_new') }}" class="inline-flex items-center px-6 py-3 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] font-medium hover:opacity-90 transition-opacity">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Create New Game
                </a>
                {% endif %}
            </div>
            <div class="mt-4">
                <a href="{{ path('app_index') }}" class="text-[#D4AF37] hover:underline flex items-center">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    Back to site
                </a>
            </div>
        </div>

        <!-- Search and Sort Controls -->
        <div class="flex justify-between items-center mb-6">
            <div class="text-2xl font-bold">All Games</div>
            <div class="flex space-x-2">
                <!-- Search Input -->
                <div class="relative">
                    <input type="text" 
                           id="gameSearch" 
                           placeholder="Search games..." 
                           class="pl-10 pr-4 py-2 rounded-md bg-[#12121a] border border-[#D4AF37]/30 text-white text-sm w-64 focus:outline-none focus:border-[#D4AF37]">
                    <svg class="w-5 h-5 absolute left-3 top-2.5 text-gray-400" 
                         fill="none" 
                         stroke="currentColor" 
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round" 
                              stroke-linejoin="round" 
                              stroke-width="2" 
                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
                
                <!-- Sort Dropdown -->
                <select id="sortSelect" class="px-4 py-2 rounded-md bg-[#12121a] border border-[#D4AF37]/30 text-white text-sm">
                    
                    <option value="name_asc">Name (A-Z)</option>
                    <option value="name_desc">Name (Z-A)</option>
                    <option value="genre_asc">Genre (A-Z)</option>
                    <option value="genre_desc">Genre (Z-A)</option>
                </select>
            </div>
        </div>

        <div id="gamesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for g in games %}
                <div class="game-card border border-[#D4AF37]/20 rounded-lg bg-[#12121a] p-6 hover:border-[#D4AF37]/50 transition-all"
                     data-id="{{ g.getGameId() }}"
                     data-name="{{ g.getName()|lower }}"
                     data-genre="{{ g.getGenre()|lower }}">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-3">
                            <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[#D4AF37]/10 text-[#D4AF37] font-bold">
                                {{ g.getGameId() }}
                            </span>
                            <div>
                                <div class="text-xl font-bold text-white">{{ g.getName() }}</div>
                                <div class="text-xs text-gray-400">{{ g.getGenre() }}</div>
                            </div>
                        </div>
                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-[#0a0a0f] border border-[#D4AF37]/20 text-[#D4AF37]">GAME</span>
                    </div>
                    <div class="flex gap-2">
                        <a href="{{ path('game_detail', {id: g.getGameId()}) }}" class="flex-1 px-3 py-2 rounded-md bg-[#D4AF37]/10 text-[#D4AF37] hover:bg-[#D4AF37]/20 text-sm font-medium text-center">View</a>
                        {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('game_edit', {id: g.getGameId()}) }}" class="flex-1 px-3 py-2 rounded-md border border-gray-400 text-gray-300 hover:bg-[#1e1e2e] text-sm font-medium text-center">Edit</a>
                        {% if is_granted('ROLE_ADMIN') %}
                        <form method="post" action="{{ path('game_delete', {id: g.getGameId()}) }}" style="flex: 1" onsubmit="return confirm('Are you sure you want to delete this game?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ g.getGameId()) }}">
                            <button type="submit" class="w-full px-3 py-2 rounded-md border border-red-600 text-red-600 hover:bg-red-600/10 text-sm font-medium">Delete</button>
                        </form>
                        {% endif %}
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div id="noGamesBlock" class="col-span-full text-center py-12 text-gray-400">
                    <div class="flex flex-col items-center justify-center">
                        <svg class="w-12 h-12 text-gray-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <p class="text-lg">No games found</p>
                        <p class="text-sm">Create your first game to get started</p>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div id="noResults" class="text-center py-12 hidden">
            <p class="text-gray-400 mb-4">No games found matching your search</p>
            <button id="clearSearch" class="px-6 py-2 rounded-md bg-[#D4AF37]/10 text-[#D4AF37] font-medium hover:bg-[#D4AF37]/20">Clear Search</button>
        </div>

        <!-- Pagination Info -->
        {% if total is defined %}
        <div class="mt-6 p-4 bg-[#12121a] border border-[#D4AF37]/20 rounded-lg">
            <div class="flex items-center justify-between">
                <div class="text-gray-400">
                    <span class="text-[#D4AF37] font-bold">{{ total }}</span> total games
                </div>
                <div class="text-gray-400">
                    Page <span class="text-[#D4AF37] font-bold">{{ page }}</span>
                </div>
            </div>
        </div>
        {% endif %}

       
            
        </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-[#D4AF37]/20 bg-[#0a0a0f] mt-16">
        <div class="container mx-auto px-4 py-8">
            <div class="text-center text-gray-400 text-sm">
                <p>&copy; 2026 CarthageGG. All rights reserved.</p>
                <p class="mt-2">Tunisia's Premier Esports Platform</p>
            </div>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('gameSearch');
            const sortSelect = document.getElementById('sortSelect');
            const gameCards = document.querySelectorAll('.game-card');
            const gamesGrid = document.getElementById('gamesGrid');
            const noResults = document.getElementById('noResults');
            const clearSearch = document.getElementById('clearSearch');
            const noGamesBlock = document.getElementById('noGamesBlock');

            function updateGames() {
                const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';
                const sortValue = sortSelect ? sortSelect.value : 'name_asc';
                let cards = Array.from(gameCards);

                if (searchTerm) {
                    cards = cards.filter(card => {
                        const name = card.getAttribute('data-name') || '';
                        const genre = card.getAttribute('data-genre') || '';
                        return name.includes(searchTerm) || genre.includes(searchTerm);
                    });
                }

                cards.sort((a, b) => {
                    switch (sortValue) {
                        case 'name_asc':
                            return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
                        case 'name_desc':
                            return (b.getAttribute('data-name') || '').localeCompare(a.getAttribute('data-name') || '');
                        case 'genre_asc':
                            return (a.getAttribute('data-genre') || '').localeCompare(b.getAttribute('data-genre') || '');
                        case 'genre_desc':
                            return (b.getAttribute('data-genre') || '').localeCompare(a.getAttribute('data-genre') || '');
                        default:
                            return 0;
                    }
                });

                gameCards.forEach(card => card.style.display = 'none');
                cards.forEach(card => {
                    card.style.display = 'block';
                    gamesGrid.appendChild(card);
                });

                const visibleCount = cards.length;
                if (visibleCount === 0 && searchTerm) {
                    if (noResults) noResults.classList.remove('hidden');
                    if (gamesGrid) gamesGrid.classList.add('hidden');
                    if (noGamesBlock) noGamesBlock.classList.add('hidden');
                } else {
                    if (noResults) noResults.classList.add('hidden');
                    if (gamesGrid) gamesGrid.classList.remove('hidden');
                    if (noGamesBlock) noGamesBlock.classList.add('hidden');
                }
            }

            if (searchInput) searchInput.addEventListener('input', updateGames);
            if (sortSelect) sortSelect.addEventListener('change', updateGames);
            if (clearSearch) {
                clearSearch.addEventListener('click', function() {
                    searchInput.value = '';
                    updateGames();
                });
            }
            updateGames();
        });
    </script>
</body>
</html>
{% endblock %}
