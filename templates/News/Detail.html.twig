{% extends "base.html.twig" %}

{% block title %}{{ news.titre }} - CarthageGG News{% endblock %}

{% block content %}
<section class="py-12 px-6 bg-gradient-to-b from-[#0a0a0f] to-[#1a1a24]">
    <div class="container mx-auto max-w-4xl">
        <!-- Back Button -->
        <a href="{{ path('app_news_list') }}" class="inline-flex items-center text-[#D4AF37] hover:text-[#B8941F] transition mb-8">
            ← Back to News
        </a>

        <!-- Article Header -->
        <header class="mb-8">
            <!-- Category -->
            <div class="mb-4">
                <span class="inline-block px-4 py-1 bg-[#D4AF37]/10 text-[#D4AF37] rounded-full text-sm font-semibold uppercase">
                    {{ news.categorie ?? 'General' }}
                </span>
            </div>

            <!-- Title -->
            <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
                {{ news.titre }}
            </h1>

            <!-- Meta Info -->
            <div class="flex flex-col md:flex-row md:items-center gap-4 text-gray-400 border-b border-[#D4AF37]/10 pb-6">
                <time datetime="{{ news.datePublication|date('c') }}">
                    📅 {{ news.datePublication|date('F d, Y') }}
                </time>
            </div>
        </header>

        <!-- Featured Image -->
        <div class="mb-8 rounded-xl overflow-hidden bg-[#1a1a24] border border-[#D4AF37]/10">
            {% if news.image and news.image != 'default-news.jpg' %}
                <img src="{{ asset('uploads/news/' ~ news.image) }}" alt="{{ news.titre }}" class="w-full h-auto">
            {% else %}
                <img src="{{ asset('assets/images/zz.png') }}" alt="{{ news.titre }}" class="w-full h-auto opacity-80">
            {% endif %}
        </div>

        <!-- Article Content -->
        <article class="prose prose-invert max-w-none mb-12">
            <div class="text-lg text-gray-300 leading-relaxed whitespace-pre-wrap">
                {{ news.contenu }}
            </div>
        </article>

        <!-- Divider -->
        <hr class="border-[#D4AF37]/10 my-8">

        <!-- Comments Section -->
        <section id="comments" class="mt-12">
            <h2 class="text-2xl font-bold text-white mb-8">Comments</h2>

            <!-- Add Comment Form (TOP) -->
            <div class="bg-[#12121a] rounded-xl border border-[#D4AF37]/10 p-6 mb-12">
                <h3 class="text-lg font-bold text-white mb-4">Add Your Comment</h3>
                
                <form id="addCommentForm" class="space-y-3">
                    <!-- Comment Textarea with Inline Emoji Buttons -->
                    <div class="relative">
                        <textarea 
                            id="commentContent"
                            name="contenu" 
                            rows="4" 
                            placeholder="Share your thoughts... (emojis supported 😊)"
                            class="w-full px-4 py-3 bg-[#1a1a24] border border-[#D4AF37]/20 rounded-lg text-white text-base focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] resize-none pr-12"
                        ></textarea>
                        
                        <!-- Emoji Buttons (Inside textarea area on bottom-right) -->
                        <div class="absolute bottom-2 right-2 flex gap-1">
                            <button 
                                type="button" 
                                id="emojiPickerToggle"
                                class="px-2 py-1 bg-[#D4AF37]/20 text-[#D4AF37] rounded text-xs hover:bg-[#D4AF37]/30 transition font-bold"
                                title="Add Emoji"
                            >
                                😊
                            </button>
                        </div>
                    </div>

                    <!-- Character Counter -->
                    <div class="text-xs text-gray-500 text-right">
                        <span id="charCount">0</span> / 5000 characters
                    </div>

                    <!-- Emoji Picker Grid (Hidden) -->
                    <div id="emojiPicker" class="hidden bg-[#1a1a24] border border-[#D4AF37]/20 rounded-lg p-3 grid grid-cols-8 sm:grid-cols-10 gap-1 max-h-40 overflow-y-auto">
                        <!-- Emojis will be populated by JavaScript -->
                    </div>

                    <!-- GIF Button -->
                    <div class="flex gap-2">
                        <button 
                            type="button" 
                            id="openGifPickerBtn"
                            class="px-4 py-2 bg-purple-500/20 text-purple-400 rounded-lg hover:bg-purple-500/30 transition font-medium text-sm"
                        >
                            🎬 Add GIF
                        </button>
                        <span id="gifFileName" class="text-xs text-gray-400 flex items-center"></span>
                    </div>

                    <!-- Selected GIF Preview -->
                    <div id="gifPreview" class="hidden">
                        <img id="gifPreviewImg" src="" alt="GIF Preview" class="max-w-xs max-h-32 rounded-lg">
                        <button 
                            type="button" 
                            onclick="document.getElementById('gifPreview').classList.add('hidden'); document.getElementById('selectedGifUrl').value = ''; document.getElementById('gifFileName').textContent = '';"
                            class="mt-2 text-xs text-red-500 hover:text-red-400"
                        >
                            Remove GIF
                        </button>
                    </div>

                    <!-- Hidden GIF URL field -->
                    <input type="hidden" id="selectedGifUrl" name="gif_url">

                    <!-- Submit Buttons -->
                    <div class="flex gap-3 pt-2">
                        <button 
                            type="submit"
                            class="flex-1 px-6 py-3 bg-[#D4AF37] text-[#0a0a0f] rounded-lg font-bold hover:bg-[#B8941F] transition"
                        >
                            Post Comment
                        </button>
                        <button 
                            type="reset"
                            onclick="document.getElementById('emojiPicker').classList.add('hidden'); document.getElementById('gifPreview').classList.add('hidden'); document.getElementById('gifFileName').textContent = '';"
                            class="px-6 py-3 bg-[#D4AF37]/10 text-[#D4AF37] rounded-lg font-medium hover:bg-[#D4AF37]/20 transition"
                        >
                            Clear
                        </button>
                    </div>
                </form>
            </div>

            <!-- Comments Container (BELOW FORM) -->
            <div id="comments-container" class="space-y-6">
                <!-- Comments will be loaded here by JavaScript -->
                <div class="text-center text-gray-400">Loading comments...</div>
            </div>
        </section>

        <!-- Navigation -->
        <div class="flex justify-between items-center mt-12 pt-8 border-t border-[#D4AF37]/10">
            <a href="{{ path('app_news_list') }}" class="px-6 py-3 bg-[#D4AF37]/10 text-[#D4AF37] rounded-lg hover:bg-[#D4AF37]/20 transition font-medium">
                ← All News
            </a>

            <!-- Share Info -->
            <div class="text-sm text-gray-500">
                News ID: {{ news.newsId }}
            </div>
        </div>
    </div>
</section>

<!-- GIF Picker Modal -->
<div id="gifPickerModal" class="fixed inset-0 bg-black/50 z-50 items-center justify-center hidden flex-col p-4">
    <div class="bg-[#12121a] rounded-xl border border-[#D4AF37]/20 max-w-4xl w-full max-h-[80vh] overflow-hidden flex flex-col">
        <!-- Header -->
        <div class="p-6 border-b border-[#D4AF37]/10 flex justify-between items-center">
            <h2 class="text-xl font-bold text-white">Select a GIF</h2>
            <button type="button" onclick="closeGifPicker()" class="text-gray-400 hover:text-white text-2xl">&times;</button>
        </div>

        <!-- Popular GIFs Grid -->
        <div class="p-6 overflow-y-auto flex-1">
            <div id="gifGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                <!-- GIFs will be populated by JavaScript -->
            </div>
        </div>
    </div>
</div>

<script>
    const newsId = {{ news.newsId }};
    const apiBaseUrl = '{{ path('api_comments_news', {'news_id': '__ID__'}) }}'.replace('__ID__', newsId);

    // Common emojis for quick selection
    const emojis = ['😂', '❤️', '🔥', '👍', '😍', '🎮', '😎', '🤔', '👏', '🎉', '😢', '😡', '🤯', '💯', '🚀', '✨', '👌', '💪', '🎊', '😎', '🔔', '⭐'];

    // Popular pre-made GIFs
    const popularGifs = [
        { name: 'Like', url: 'https://media.giphy.com/media/l0HlNaQ9mnnoQ7aKs/giphy.gif' },
        { name: 'Love', url: 'https://media.giphy.com/media/3o7TKU9Z0i0vs9pHIs/giphy.gif' },
        { name: 'Fire', url: 'https://media.giphy.com/media/11sBLVxNZZ6PiU/giphy.gif' },
        { name: 'Wow', url: 'https://media.giphy.com/media/l3q2K5jinAlZ6FAyt/giphy.gif' },
        { name: 'Clap', url: 'https://media.giphy.com/media/lnOG2ZP2FYLlib0EM1/giphy.gif' },
        { name: 'Laugh', url: 'https://media.giphy.com/media/l0MYt5jPR6QX5pnqM/giphy.gif' },
        { name: 'Cry', url: 'https://media.giphy.com/media/jLaqaCJaH0g1qKRFpn/giphy.gif' },
        { name: 'Angry', url: 'https://media.giphy.com/media/l3q2K5jinAlZ6FAyt/giphy.gif' },
        { name: 'Cool', url: 'https://media.giphy.com/media/3o7TKU9Z0i0jnS3Jd2/giphy.gif' },
        { name: 'Thinking', url: 'https://media.giphy.com/media/l0MYt5jPR6QX5pnqM/giphy.gif' },
        { name: 'Shock', url: 'https://media.giphy.com/media/l3q2K5jinAlZ6FAyt/giphy.gif' },
        { name: 'Victory', url: 'https://media.giphy.com/media/l0HlNaQ9mnnoQ7aKs/giphy.gif' },
    ];

    // Initialize emoji picker
    function initEmojiPicker() {
        const picker = document.getElementById('emojiPicker');
        emojis.forEach(emoji => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = emoji;
            btn.className = 'text-xl hover:bg-[#D4AF37]/10 p-1 rounded transition';
            btn.onclick = (e) => {
                e.preventDefault();
                const textarea = document.getElementById('commentContent');
                textarea.focus();
                textarea.value += emoji;
                updateCharCount();
            };
            picker.appendChild(btn);
        });
    }

    // Toggle emoji picker
    document.getElementById('emojiPickerToggle').addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById('emojiPicker').classList.toggle('hidden');
    });

    // Initialize GIF picker
    function initGifPicker() {
        const grid = document.getElementById('gifGrid');
        grid.innerHTML = '';
        popularGifs.forEach(gif => {
            const item = document.createElement('div');
            item.className = 'cursor-pointer bg-[#1a1a24] rounded-lg overflow-hidden border border-[#D4AF37]/10 hover:border-[#D4AF37]/30 transition';
            item.onclick = () => selectGif(gif);
            item.innerHTML = `
                <img src="${gif.url}" alt="${gif.name}" class="w-full h-32 object-cover hover:scale-105 transition">
                <p class="p-2 text-sm text-gray-300 text-center">${gif.name}</p>
            `;
            grid.appendChild(item);
        });
    }

    // Open GIF picker
    document.getElementById('openGifPickerBtn').addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById('gifPickerModal').classList.remove('hidden');
        document.getElementById('gifPickerModal').classList.add('flex');
        initGifPicker();
    });

    // Close GIF picker
    function closeGifPicker() {
        document.getElementById('gifPickerModal').classList.add('hidden');
        document.getElementById('gifPickerModal').classList.remove('flex');
    }

    // Select GIF
    function selectGif(gif) {
        document.getElementById('selectedGifUrl').value = gif.url;
        document.getElementById('gifPreviewImg').src = gif.url;
        document.getElementById('gifFileName').textContent = `📹 ${gif.name} selected`;
        document.getElementById('gifPreview').classList.remove('hidden');
        closeGifPicker();
    }

    // Character counter
    function updateCharCount() {
        const content = document.getElementById('commentContent').value;
        document.getElementById('charCount').textContent = content.length;
    }

    document.getElementById('commentContent').addEventListener('input', updateCharCount);

    // Load comments
    async function loadComments() {
        try {
            const response = await fetch(apiBaseUrl);
            const comments = await response.json();
            displayComments(comments);
        } catch (error) {
            console.error('Error loading comments:', error);
            document.getElementById('comments-container').innerHTML =
                '<div class="text-center text-red-500">Failed to load comments</div>';
        }
    }

    // Display comments
    function displayComments(comments) {
        const container = document.getElementById('comments-container');
        
        if (comments.length === 0) {
            container.innerHTML = '<div class="text-center text-gray-400 py-8">No comments yet. Be the first to comment!</div>';
            return;
        }

        container.innerHTML = comments.map(comment => {
            const voteKey = `comment_vote_${comment.commentaire_id}`;
            const userVote = localStorage.getItem(voteKey) || 'none'; // 'none', 'upvote', 'downvote'
            
            return `
                <div class="bg-[#12121a] rounded-lg border border-[#D4AF37]/10 p-6">
                    <!-- Comment Text & GIF -->
                    <div class="mb-4">
                        <p id="comment-content-${comment.commentaire_id}" class="text-gray-300 mb-3">${escapeHtml(comment.contenu)}</p>
                        ${comment.gif_url ? `<img src="${comment.gif_url}" alt="GIF" class="rounded-lg max-w-xs max-h-40 mb-3" onerror="this.style.display='none'">` : ''}
                    </div>

                    <!-- Timestamp -->
                    <div class="text-xs text-gray-500 mb-3 pb-3 border-b border-[#D4AF37]/10">
                        <time>${formatDate(comment.date_commentaire)}</time>
                    </div>

                    <!-- Vote Buttons -->
                    <div class="flex gap-3">
                        <button 
                            onclick="voteComment(${comment.commentaire_id}, 'upvote')"
                            class="flex items-center gap-1 px-3 py-2 rounded-lg transition ${userVote === 'upvote' ? 'bg-green-500/20 text-green-400' : 'bg-[#D4AF37]/10 text-gray-400 hover:text-[#D4AF37]'}"
                        >
                            👍 <span class="text-sm font-medium">${comment.upvotes}</span>
                        </button>
                        <button 
                            onclick="voteComment(${comment.commentaire_id}, 'downvote')"
                            class="flex items-center gap-1 px-3 py-2 rounded-lg transition ${userVote === 'downvote' ? 'bg-red-500/20 text-red-400' : 'bg-[#D4AF37]/10 text-gray-400 hover:text-[#D4AF37]'}"
                        >
                            👎 <span class="text-sm font-medium">${comment.downvotes}</span>
                        </button>
                    </div>

                    <!-- Edit / Delete Buttons -->
                    <div class="flex gap-2 mt-3">
                        <button
                            onclick="editComment(${comment.commentaire_id})"
                            class="px-3 py-2 text-xs bg-[#D4AF37]/10 text-[#D4AF37] rounded hover:bg-[#D4AF37]/20 transition"
                        >
                            ✏️ Edit
                        </button>
                        <button
                            onclick="deleteComment(${comment.commentaire_id})"
                            class="px-3 py-2 text-xs bg-red-600/10 text-red-400 rounded hover:bg-red-600/20 transition"
                        >
                            🗑️ Delete
                        </button>
                    </div>
                </div>
            `;
        }).join('');
    }

    // Vote on comment
    async function voteComment(commentId, voteType) {
        const voteKey = `comment_vote_${commentId}`;
        const currentVote = localStorage.getItem(voteKey) || 'none';
        
        // Map upvote/downvote to up/down for API
        const apiVoteType = voteType === 'upvote' ? 'up' : 'down';
        const apiCurrentVote = currentVote === 'upvote' ? 'up' : (currentVote === 'downvote' ? 'down' : null);

        // If user already voted with this type, undo it
        if (currentVote === voteType) {
            // Undo vote
            await sendVote(commentId, null, apiCurrentVote, true);
            localStorage.removeItem(voteKey);
        } else if (currentVote === 'none') {
            // New vote
            await sendVote(commentId, apiVoteType, null, false);
            localStorage.setItem(voteKey, voteType);
        } else {
            // Change vote (switch from up to down or vice versa)
            await sendVote(commentId, apiVoteType, apiCurrentVote, false);
            localStorage.setItem(voteKey, voteType);
        }

        // Reload comments
        loadComments();
    }

    // Send vote to server
    async function sendVote(commentId, voteType, previousVote = null, undo = false) {
        try {
            const payload = {};
            if (voteType) payload.type = voteType;
            if (previousVote) payload.previous = previousVote;
            if (undo) payload.undo = true;

            const response = await fetch(`/api/comments/${commentId}/vote`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                console.error('Vote failed');
            }
        } catch (error) {
            console.error('Error voting:', error);
        }
    }

    // Format date
    function formatDate(dateStr) {
        const date = new Date(dateStr);
        const now = new Date();
        const diff = now - date;
        const hours = Math.floor(diff / 3600000);
        const days = Math.floor(diff / 86400000);
        
        if (hours < 1) return 'Just now';
        if (hours < 24) return `${hours}h ago`;
        if (days < 7) return `${days}d ago`;
        
        return date.toLocaleDateString();
    }

    // Escape HTML to prevent XSS
    function escapeHtml(text) {
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    // Submit comment form
    document.getElementById('addCommentForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const contenu = document.getElementById('commentContent').value;
        const gif_url = document.getElementById('selectedGifUrl').value;

        try {
            const response = await fetch('{{ path('api_comments_add') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    news_id: newsId,
                    contenu,
                    gif_url: gif_url || null
                })
            });

            const result = await response.json();

            if (response.ok) {
                document.getElementById('addCommentForm').reset();
                updateCharCount();
                document.getElementById('gifPreview').classList.add('hidden');
                document.getElementById('gifFileName').textContent = '';
                document.getElementById('emojiPicker').classList.add('hidden');
                // Clear any previous error message
                const errorDiv = document.getElementById('commentErrorMessage');
                if (errorDiv) errorDiv.remove();
                loadComments();
            } else {
                // Display server error message
                const errorMessage = result.error || 'Failed to post comment';
                
                // Remove previous error if exists
                const existingError = document.getElementById('commentErrorMessage');
                if (existingError) existingError.remove();
                
                // Create and display error message
                const errorDiv = document.createElement('div');
                errorDiv.id = 'commentErrorMessage';
                errorDiv.className = 'mt-3 p-3 bg-red-500/20 border border-red-500/50 text-red-400 rounded-lg text-sm';
                errorDiv.textContent = errorMessage;
                document.getElementById('addCommentForm').insertAdjacentElement('afterend', errorDiv);
            }
        } catch (error) {
            console.error('Error posting comment:', error);
            const errorDiv = document.createElement('div');
            errorDiv.id = 'commentErrorMessage';
            errorDiv.className = 'mt-3 p-3 bg-red-500/20 border border-red-500/50 text-red-400 rounded-lg text-sm';
            errorDiv.textContent = 'Error posting comment';
            document.getElementById('addCommentForm').insertAdjacentElement('afterend', errorDiv);
        }
    });

    // Delete a comment (asks for confirmation)
    async function deleteComment(commentId) {
        if (!confirm('Are you sure you want to delete this comment?')) return;

        try {
            const response = await fetch(`/api/comments/${commentId}`, {
                method: 'DELETE'
            });

            if (response.ok) {
                loadComments();
            } else {
                const res = await response.json();
                alert(res.error || 'Failed to delete comment');
            }
        } catch (err) {
            console.error('Error deleting comment:', err);
            alert('Error deleting comment');
        }
    }

    // Edit a comment using a simple prompt, then POST update
    async function editComment(commentId) {
        const el = document.getElementById(`comment-content-${commentId}`);
        const current = el ? el.textContent : '';
        const updated = prompt('Edit your comment:', current);
        if (updated === null) return; // cancelled

        try {
            const response = await fetch(`/api/comments/${commentId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ contenu: updated })
            });

            if (response.ok) {
                loadComments();
            } else {
                const res = await response.json();
                alert(res.error || 'Failed to update comment');
            }
        } catch (err) {
            console.error('Error editing comment:', err);
            alert('Error updating comment');
        }
    }

    // Close modal when clicking outside
    document.getElementById('gifPickerModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeGifPicker();
        }
    });

    // Initial setup
    initEmojiPicker();
    loadComments();
</script>
{% endblock %}
