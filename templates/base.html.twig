<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}CarthageGG{% endblock %}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="{{ asset('assets/styles/styles.css') }}">
</head>
<body class="bg-[#0a0a0f] text-[#e4e4e7] font-sans min-h-screen">
    <!-- Top navigation copied from index layout (logo left, News center, Dashboard right) -->
    <nav class="sticky top-0 z-50 border-b border-[#D4AF37]/20 bg-[#0a0a0f]/95 backdrop-blur-sm">
        <div class="container mx-auto px-4">
            <div class="flex h-16 items-center justify-between">
                <!-- Left: Logo / Home -->
                <a href="{{ path('app_index') }}" class="flex items-center space-x-2">
                    <img src="{{ asset('assets/images/zz.png') }}" alt="CarthageGG Logo" class="h-14 w-14 rounded-lg shadow-lg object-cover">
                    <span class="text-2xl font-bold text-[#D4AF37]">Carthage</span>
                    <span class="text-2xl font-bold text-white">GG</span>
                </a>

                <!-- Center: News button -->
                <div class="hidden md:flex items-center space-x-1">
                    <a href="{{ path('app_news_list') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">News</a>
                </div>

                <!-- Right: Login / Dashboard -->
                <div class="flex items-center space-x-3">
                    <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-white px-4 py-2 text-sm font-medium">Login</a>
                    <a href="{{ path('app_admin_dashboard') }}" class="px-4 py-2 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] text-sm font-medium">Dashboard</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="pt-6">
        {% block content %}{% endblock %}
    </main>

    <script src="{{ asset('assets/js/app.js') }}"></script>
</body>
</html>
