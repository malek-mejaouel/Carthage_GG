{% extends 'base.html.twig' %}
{% block title %}{{ is_edit ? 'Edit' : 'New' }} Category{% endblock %}
{% block content %}
<div class="container mx-auto px-4 py-8 max-w-2xl">
    <h1 class="text-2xl font-bold text-[#D4AF37] mb-6">{{ is_edit ? 'Edit' : 'New' }} Category</h1>
    {{ form_start(form) }}
        <div class="space-y-4">
            <div>
                {{ form_label(form.name) }}
                {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}
                {{ form_errors(form.name) }}
            </div>
            <div>
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded'}}) }}
                {{ form_errors(form.description) }}
            </div>
        </div>
        <div class="mt-6 flex gap-4">
            <button class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded hover:bg-[#B8941F]">Save</button>
            <a href="{{ path('admin_categories_index') }}" class="px-4 py-2 border border-[#D4AF37]/30 rounded text-gray-300">Cancel</a>
            <a href="{{ path('app_admin_dash_products') }}" class="px-4 py-2 border border-[#D4AF37]/40 text-[#D4AF37] rounded hover:bg-[#D4AF37]/10">Products Dashboard</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
