{% extends 'base.html.twig' %}

{% block title %}Events - CarthageGG{% endblock %}

{% block content %}
  <div class="mb-4 flex justify-between items-center">
    <h1 class="text-2xl font-bold">Events</h1>
    <a href="{{ path('event_new') }}" class="px-3 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded">Create new</a>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full table-auto border-collapse">
      <thead>
        <tr class="text-left border-b border-[#D4AF37]/20">
          <th class="px-3 py-2">ID</th>
          <th class="px-3 py-2">Title</th>
          <th class="px-3 py-2">Start</th>
          <th class="px-3 py-2">End</th>
          <th class="px-3 py-2">Location</th>
          <th class="px-3 py-2">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for e in events %}
          <tr class="hover:bg-[#0f0f15]">
            <td class="px-3 py-2">{{ e.id }}</td>
            <td class="px-3 py-2">{{ e.title }}</td>
            <td class="px-3 py-2">{{ e.startAt ? e.startAt|date('Y-m-d H:i') : '' }}</td>
            <td class="px-3 py-2">{{ e.endAt ? e.endAt|date('Y-m-d H:i') : '' }}</td>
            <td class="px-3 py-2">{{ e.location ? e.location.name : '' }}</td>
            <td class="px-3 py-2">
              <a class="text-sm text-[#D4AF37] mr-2" href="{{ path('event_show', {'id': e.id}) }}">View</a>
              <a class="text-sm text-red-400" href="{{ path('event_delete', {'id': e.id}) }}" onclick="return confirm('Delete?')">Delete</a>
            </td>
          </tr>
        {% else %}
          <tr><td class="px-3 py-2" colspan="6">No events</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}
