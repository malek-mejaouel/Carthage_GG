{% extends 'base.html.twig' %}

{% block title %}Locations - CarthageGG{% endblock %}

{% block content %}
  <div class="mb-4 flex justify-between items-center">
    <h1 class="text-2xl font-bold">Locations</h1>
    <a href="{{ path('location_new') }}" class="px-3 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded">Create new</a>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full table-auto border-collapse">
      <thead>
        <tr class="text-left border-b border-[#D4AF37]/20">
          <th class="px-3 py-2">ID</th>
          <th class="px-3 py-2">Name</th>
          <th class="px-3 py-2">Address</th>
          <th class="px-3 py-2">Capacity</th>
          <th class="px-3 py-2">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for l in locations %}
          <tr class="hover:bg-[#0f0f15]">
            <td class="px-3 py-2">{{ l.id }}</td>
            <td class="px-3 py-2">{{ l.name }}</td>
            <td class="px-3 py-2">{{ l.address ?: '' }}</td>
            <td class="px-3 py-2">{{ l.capacity ?: '' }}</td>
            <td class="px-3 py-2">
              <a class="text-sm text-[#D4AF37] mr-3" href="{{ path('location_detail', {'id': l.id}) }}">View</a>
              <a class="text-sm text-[#D4AF37] mr-3" href="{{ path('location_edit', {'id': l.id}) }}">Edit</a>
              <a class="text-sm text-red-400" href="{{ path('location_delete', {'id': l.id}) }}" onclick="return confirm('Delete?')">Delete</a>
            </td>
          </tr>
        {% else %}
          <tr><td class="px-3 py-2" colspan="5">No locations</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}
