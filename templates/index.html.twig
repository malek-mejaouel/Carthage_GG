<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tournaments - CarthageGG</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="{{ asset('assets/styles/styles.css') }}" />
</head>
<body class="bg-[#0a0a0f] text-[#e4e4e7]">
    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 border-b border-[#D4AF37]/20 bg-[#0a0a0f]/95 backdrop-blur-sm">
        <div class="w-full px-4">
            <div class="flex h-16 items-center justify-between">
                <a href="{{ path('app_index') }}" class="flex items-center space-x-2 flex-shrink-0">
                    <img src="{{ asset('assets/images/zz.png') }}" alt="CarthageGG Logo" class="h-14 w-14 rounded-lg shadow-lg object-cover">
                    <span class="text-2xl font-bold text-[#D4AF37]">Carthage</span>
                    <span class="text-2xl font-bold text-white">GG</span>
                </a>
                <div class="hidden md:flex items-center space-x-1 flex-1 justify-center ml-8">
                    <a href="{{ path('app_tournaments') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Tournaments</a>
                    <a href="{{ path('app_teams') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Teams</a>
                    <a href="{{ path('app_matches') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Matches</a>
                     <a href="{{ path('app_store') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Store</a>
                    <a href="{{ path('app_games') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Games</a>
                    <a href="{{ path('app_news') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">News</a>
                    <a href="{{ path('app_streams_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Streams</a>
                </div>
              <div class="flex items-center space-x-3">
                     {% if app.user %}
                    <a href="{{ path('app_profile_edit', {'id': app.user.id}) }}" class="text-[#e4e4e7] hover:text-[#D4AF37] transition font-bold flex items-center gap-2">
                        {% if app.user.avatar %}
                            <img src="{{ asset(app.user.avatar) }}" alt="Avatar" class="w-8 h-8 rounded-full object-cover border border-[#D4AF37]/50">
                        {% else %}
                            <div class="w-8 h-8 rounded-full bg-[#D4AF37]/20 flex items-center justify-center text-[#D4AF37]">
                                {{ app.user.firstName ? app.user.firstName|first|upper : app.user.username|first|upper }}
                            </div>
                        {% endif %}
                        {{ app.user.firstName ? app.user.firstName : app.user.username }}
                    </a>
                {% endif %}
                {% if app.user is defined and app.user %}
                    <a href="{{ path('app_logout') }}" class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded-lg hover:bg-[#B8941F] transition">Logout</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded-lg hover:bg-[#B8941F] transition">Login</a>
                {% endif %}
                </div>
            </div>
        </div>
    </nav>
    <!-- Hero Section -->
    <section class="relative overflow-hidden border-b border-[#D4AF37]/20 bg-gradient-to-b from-[#0a0a0f] via-[#12121a] to-[#0a0a0f]">
        <div class="container relative mx-auto px-4 py-24">
            <div class="mx-auto max-w-4xl text-center">
                <div class="mb-6 inline-block px-4 py-2 rounded-full bg-[#D4AF37]/10 text-[#D4AF37] border border-[#D4AF37]/30">
                    Tunisia's Premier Esports Platform
                </div>
                <h1 class="mb-6 text-5xl md:text-6xl font-bold">
                    <span class="bg-gradient-to-r from-[#D4AF37] via-[#F4D03F] to-[#D4AF37] bg-clip-text text-transparent">
                        Compete. Conquer. Claim Glory.
                    </span>
                </h1>
                <p class="mb-8 text-xl text-gray-400">
                    Join the ultimate competitive gaming platform inspired by the legendary legacy of Carthage
                </p>
                <div class="flex flex-wrap justify-center gap-4">
                    <a href="register.html" class="inline-flex items-center px-6 py-3 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] font-medium hover:opacity-90 transition-opacity">
                        <svg class="mr-2 h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                        Start Competing
                    </a>
                    <a href="tournaments.html" class="inline-flex items-center px-6 py-3 rounded-md border-2 border-[#D4AF37] text-[#D4AF37] font-medium hover:bg-[#D4AF37]/10 transition-colors">
                        Browse Tournaments
                    </a>
                </div>

                <!-- Stats -->
                <div class="mt-16 grid grid-cols-2 gap-8 md:grid-cols-4">
                    <div>
                        <div class="text-3xl font-bold text-[#D4AF37]">2,500+</div>
                        <div class="text-sm text-gray-400">Active Players</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-[#D4AF37]">150+</div>
                        <div class="text-sm text-gray-400">Tournaments</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-[#D4AF37]">$500K+</div>
                        <div class="text-sm text-gray-400">Prize Pool</div>
                    </div>
                    <div>
                        <div class="text-3xl font-bold text-[#D4AF37]">80+</div>
                        <div class="text-sm text-gray-400">Teams</div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="container mx-auto px-4 py-12">
        <div class="mb-6">
            <h2 class="text-4xl font-bold mb-2">Events</h2>
            <p class="text-gray-400">Discover upcoming events and meetups.</p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {% for e in events %}
                <div class="border border-[#D4AF37]/10 rounded-lg bg-[#12121a] p-4 flex flex-col">
                    <div class="flex justify-between items-start">
                        <h3 class="text-lg font-bold">{{ e.title }}</h3>
                        {% if e.startAt %}
                            <span class="px-2 py-1 bg-[#0b0b10] rounded text-xs">{{ e.startAt|date('M d, Y H:i') }}</span>
                        {% endif %}
                    </div>
                    {% if e.description %}
                        <p class="text-sm text-gray-400 mt-2">{{ e.description|length > 140 ? e.description|slice(0,140) ~ '…' : e.description }}</p>
                    {% endif %}
                    <div class="mt-3 text-sm text-gray-300 flex flex-wrap gap-2 items-center">
                        {% if e.location %}
                            <div class="px-2 py-1 bg-[#0b0b10] rounded">Location: {{ e.location.name }}</div>
                        {% endif %}
                        <div class="px-2 py-1 bg-[#0b0b10] rounded">Seats left: {{ e.availableSeats }}</div>
                    </div>
                    <div class="mt-3">
                        <a href="{{ path('event_show', {'id': e.id}) }}" class="px-3 py-2 rounded bg-transparent border border-[#2a2a34] text-sm hover:bg-[#1a1a24]">View</a>
                    </div>
                </div>
            {% else %}
                <div class="col-span-full text-gray-400">No events</div>
            {% endfor %}
        </div>
    </section>
     <section class="container mx-auto px-4 py-12">
        <div class="mb-6">
            <h2 class="text-4xl font-bold mb-2">Locations</h2>
            <p class="text-gray-400">Find a venue near you — search, filter and book.</p>
        </div>

        <!-- Search & Filters -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
            <div class="flex-1">
                <input id="locationSearch" type="search" placeholder="Search locations or address..." class="w-full px-4 py-3 rounded bg-[#0b0b10] border border-[#2a2a34] text-gray-200 focus:outline-none" />
            </div>
            <div class="flex items-center gap-3">
                <label class="text-sm text-gray-400">City:</label>
                <select id="cityFilter" class="px-3 py-2 bg-[#0a0a0f] border border-[#2a2a34] rounded text-gray-200">
                    <option value="all">All</option>
                    <option value="Tunis">Tunis</option>
                    <option value="Sousse">Sousse</option>
                    <option value="Sfax">Sfax</option>
                    <option value="Nabeul">Nabeul</option>
                </select>
            </div>
        </div>

        <!-- Locations Grid -->
        <div id="locationsGrid" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {# Example static cards — replace with dynamic `locations` variable if available #}
            {% set sample_locations = [
                {"id":1, "name":"Arena Tunis", "city":"Tunis", "addr":"Avenue Habib Bourguiba, Tunis", "lat":36.8065, "lng":10.1815, "featured":true, "status":"Open", "capacity":40, "pcs":20, "price":6, "amenities":["WiFi","Screens"]},
                {"id":2, "name":"Sousse eArena", "city":"Sousse", "addr":"Corniche Sousse", "lat":35.8256, "lng":10.63699, "featured":false, "status":"Closed", "capacity":30, "pcs":15, "price":5, "amenities":["WiFi"]},
                {"id":3, "name":"Sfax Gaming Hub", "city":"Sfax", "addr":"Rue de la Plage, Sfax", "lat":34.7406, "lng":10.7603, "featured":false, "status":"Open", "capacity":50, "pcs":25, "price":7, "amenities":["WiFi","Screens","Drinks"]}
            ] %}

            {% for loc in (locations is defined ? locations : sample_locations) %}
                <div class="border border-[#D4AF37]/10 rounded-lg bg-[#12121a] p-4 flex flex-col">
                    <div class="relative">
                        <img src="{{ asset('assets/images/venue-placeholder.jpg') }}" alt="{{ loc.name }}" class="h-44 w-full object-cover rounded" />
                        <div class="absolute top-3 left-3 flex gap-2">
                            {% if loc.featured %}
                                <span class="px-3 py-1 rounded-full bg-[#D4AF37] text-[#0a0a0f] text-xs font-semibold">Featured</span>
                            {% endif %}
                            <span class="px-2 py-1 rounded bg-white/10 text-xs">{{ loc.city }}</span>
                        </div>
                        <div class="absolute top-3 right-3">
                            <span class="px-2 py-1 rounded text-xs {{ loc.status == 'Open' ? 'bg-green-500/20 text-green-300' : 'bg-red-500/20 text-red-300' }}">{{ loc.status }}</span>
                        </div>
                    </div>
                    <div class="mt-3 flex-1">
                        <h3 class="text-lg font-bold">{{ loc.name }}</h3>
                        <p class="text-sm text-gray-400">{{ loc.addr }}</p>

                        <div class="mt-3 text-sm text-gray-300 flex flex-wrap gap-2 items-center">
                            <div class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                                <span>4.6</span>
                            </div>
                            <div class="px-2 py-1 bg-[#0b0b10] rounded">Capacity: {{ loc.capacity }}</div>
                            <div class="px-2 py-1 bg-[#0b0b10] rounded">PCs: {{ loc.pcs }}</div>
                            <div class="px-2 py-1 bg-[#0b0b10] rounded">{{ loc.amenities|join(', ') }}</div>
                            <div class="ml-auto font-bold text-[#D4AF37]">{{ loc.price }} DT/h</div>
                        </div>

                        <div class="mt-3 grid grid-cols-2 gap-2">
                            <a href="{{ path('location_detail', {'id': loc.id}) }}" class="block text-center px-3 py-2 rounded bg-transparent border border-[#2a2a34] text-sm hover:bg-[#1a1a24]">Details</a>
                            <a href="{{ path('location_book', {'id': loc.id}) }}" data-book-id="{{ loc.id }}" data-book-name="{{ loc.name }}" data-book-lat="{{ loc.lat }}" data-book-lng="{{ loc.lng }}" data-book-price="{{ loc.price }}" class="bookBtn block text-center px-3 py-2 rounded bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] text-sm font-semibold">Book</a>
                        </div>
                    </div>

                    <div class="mt-3">
                        <div class="w-full h-36 rounded overflow-hidden border border-[#2a2a34]" data-lat="{{ loc.lat }}" data-lng="{{ loc.lng }}"></div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
    <!-- Footer -->
    <footer class="border-t border-[#D4AF37]/20 bg-[#0a0a0f] mt-16">
        <div class="container mx-auto px-4 py-12">
            <div class="grid md:grid-cols-4 gap-8 mb-8">
                <div>
                    <h3 class="font-bold text-[#D4AF37] mb-4">CarthageGG</h3>
                    <p class="text-gray-400 text-sm">Tunisia's premier esports platform</p>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Platform</h4>
                    <ul class="space-y-2 text-gray-400 text-sm">
                        <li><a href="tournaments.html" class="hover:text-[#D4AF37] transition-colors">Tournaments</a></li>
                        <li><a href="teams.html" class="hover:text-[#D4AF37] transition-colors">Teams</a></li>
                        <li><a href="matches.html" class="hover:text-[#D4AF37] transition-colors">Matches</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Compete</h4>
                    <ul class="space-y-2 text-gray-400 text-sm">
                        <li><a href="leaderboard.html" class="hover:text-[#D4AF37] transition-colors">Leaderboard</a></li>
                        <li><a href="register.html" class="hover:text-[#D4AF37] transition-colors">Register</a></li>
                        <li><a href="support.html" class="hover:text-[#D4AF37] transition-colors">Support</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Follow</h4>
                    <div class="flex space-x-4">
                        <a href="#" class="text-gray-400 hover:text-[#D4AF37] transition-colors">Twitter</a>
                        <a href="#" class="text-gray-400 hover:text-[#D4AF37] transition-colors">Discord</a>
                        <a href="#" class="text-gray-400 hover:text-[#D4AF37] transition-colors">YouTube</a>
                    </div>
                </div>
            </div>
            <div class="border-t border-[#D4AF37]/20 pt-8 text-center text-gray-400 text-sm">
                <p>&copy; 2026 CarthageGG. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="js/main.js"></script>
</body>
</html>
  
