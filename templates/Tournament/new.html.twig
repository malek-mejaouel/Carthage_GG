<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Tournament - CarthageGG</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="{{ asset('assets/styles/styles.css') }}" />
    <style>
        .form-control { background: #0a0a0f; border: 1px solid rgba(212,175,55,0.2); color: #fff; }
        .form-control:focus { outline: none; border-color: #D4AF37; }
    </style>
    </head>
<body class="bg-[#0a0a0f] text-[#e4e4e7]">
    <div class="container mx-auto px-4 py-12">
        <div class="flex items-center space-x-4 mb-8">
            <a href="{{ path('tournament_index') }}" class="text-gray-400 hover:text-white">← Back to Tournaments</a>
        </div>
        <h1 class="text-4xl font-bold mb-4">Create Tournament</h1>
        <p class="text-gray-400">Fill in the details to create a new tournament</p>
    </div>

    <div class="container mx-auto px-4 pb-12">
        <div class="max-w-2xl mx-auto border border-[#D4AF37]/20 rounded-lg bg-[#12121a] p-8">
            {% if form_errors(form) %}
                <div class="mb-6 p-4 rounded-lg bg-red-600/10 border border-red-600 text-red-600">
                    {{ form_errors(form) }}
                </div>
            {% endif %}

            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                {% for child in form %}
                    {% if child.vars.name != 'csrf_token' and child.vars.name != '_token' %}
                        <div class="form-group">
                            {{ form_label(child, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                            {{ form_widget(child, {'attr': {'class': 'w-full px-4 py-2 rounded-lg form-control'}}) }}
                            {% if form_errors(child) %}
                                <div class="text-red-600 text-xs mt-1">{{ form_errors(child) }}</div>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}

                <div class="flex gap-4 pt-6">
                    <button type="submit" class="flex-1 px-6 py-2 rounded-lg bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] font-medium hover:opacity-90">Create</button>
                    <a href="{{ path('tournament_index') }}" class="flex-1 px-6 py-2 rounded-lg border border-gray-400 text-gray-300 hover:bg-[#1e1e2e] font-medium text-center">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</body>
</html>
