{% extends 'base.html.twig' %}

{% block title %}Book Location - CarthageGG{% endblock %}

{% block content %}
  <div class="mb-4 flex justify-between items-center">
    <h1 class="text-2xl font-bold">Book {{ location.name }}</h1>
    <div>
      <a href="{{ path('location_detail', {'id': location.id}) }}" class="px-3 py-2 ml-2 border rounded">Back</a>
    </div>
  </div>

  <form method="post" class="space-y-4 max-w-lg">
    <div>
      <label class="block mb-1">Your name</label>
      <input class="w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded" name="full_name" type="text" required>
    </div>
    <div>
      <label class="block mb-1">Date</label>
      <input class="w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded" name="date" type="date" required>
    </div>
    <div>
      <label class="block mb-1">Hours</label>
      <input class="w-full px-3 py-2 bg-[#12121a] border border-[#D4AF37]/20 rounded" name="hours" type="number" min="1" required>
    </div>
    <button class="px-3 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded" type="submit">Request Booking</button>
  </form>
{% endblock %}
