<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts | CarthageGG</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-[#0a0a0f] text-[#e4e4e7]">
    {% include 'admin/_sidebar.html.twig' %}
    <div class="lg:ml-64 flex flex-col min-h-screen">
    <main class="flex-1 p-6">
    <div class="container mx-auto px-6 py-8">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-2xl font-bold text-white">Posts</h1>
            <a href="{{ path('app_admin_dashboard') }}" class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded-lg font-bold hover:bg-[#B8941F] transition">Back to Dashboard</a>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            <div class="lg:col-span-2 bg-[#12121a] rounded-xl border border-[#D4AF37]/10 p-6">
                <h3 class="text-lg font-bold text-white mb-4">Post Views</h3>
                <div class="relative h-80">
                    <canvas id="viewsChart"></canvas>
                </div>
            </div>
            <div class="bg-[#12121a] rounded-xl border border-[#D4AF37]/10 p-6">
                <h3 class="text-lg font-bold text-white mb-4">Category Share</h3>
                <div class="relative h-64">
                    <canvas id="postCategoryChart"></canvas>
                </div>
            </div>
        </div>
        <div class="bg-[#12121a] rounded-xl border border-[#D4AF37]/10 overflow-hidden">
            <div class="p-6 border-b border-[#D4AF37]/10 flex justify-between items-center">
                <h3 class="text-lg font-bold text-white">Posts Management</h3>
                <div class="flex gap-2">
                    <a href="{{ path('app_admin_dash_news') }}" class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded-lg text-sm font-bold hover:bg-[#B8941F] transition">Add News</a>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-400">
                    <thead class="bg-[#1a1a24] text-[#D4AF37] uppercase font-bold text-xs">
                        <tr>
                            <th class="px-6 py-4">Title</th>
                            <th class="px-6 py-4">Author</th>
                            <th class="px-6 py-4">Date</th>
                            <th class="px-6 py-4 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#D4AF37]/10">
                        {% for post in posts %}
                            <tr class="table-row-hover transition">
                                <td class="px-6 py-4 font-medium text-white">{{ post.titre }}</td>
                                <td class="px-6 py-4">N/A</td>
                                <td class="px-6 py-4">{{ post.datePublication ? post.datePublication|date('Y-m-d') : 'N/A' }}</td>
                                <td class="px-6 py-4 text-center">
                                    <a href="{{ path('app_admin_news_edit', {'newsId': post.newsId}) }}" class="text-blue-400 hover:text-blue-300 mr-3">Edit</a>
                                    <form action="{{ path('app_admin_news_delete', {'newsId': post.newsId}) }}" method="POST" class="inline" onsubmit="return confirm('Delete this post?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.newsId) }}">
                                        <button type="submit" class="text-red-400 hover:text-red-300">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center opacity-60 py-6">No posts found</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    </main>
    </div>
    <script>
        const viewsCtx = document.getElementById('viewsChart');
        new Chart(viewsCtx, {
            type: 'line',
            data: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                datasets: [{ label: 'Views', data: [1200, 950, 1400, 1600, 1800, 2100, 1950], borderColor: '#3B82F6', backgroundColor: 'rgba(59,130,246,0.1)' }]
            },
            options: { scales: { x: { ticks: { color: '#9CA3AF' } }, y: { ticks: { color: '#9CA3AF' } } } }
        });
        const postCategoryCtx = document.getElementById('postCategoryChart');
        new Chart(postCategoryCtx, {
            type: 'doughnut',
            data: {
                labels: ['News', 'Guides', 'Recaps'],
                datasets: [{ data: [40, 35, 25], backgroundColor: ['#D4AF37', '#10B981', '#A855F7'] }]
            },
            options: { plugins: { legend: { labels: { color: '#e4e4e7' } } } }
        });
    </script>
</script>
<script src="{{ asset('js/admin-dashboard.js') }}"></script>
</body>
</html>
