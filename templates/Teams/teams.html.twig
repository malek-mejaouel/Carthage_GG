{% extends "base.html.twig" %}

{% block title %}News - CarthageGG{% endblock %}
{% block content %}

    <!-- Page Header -->
    <div class="container mx-auto px-4 py-12">
        <h1 class="text-4xl font-bold mb-4">Teams</h1>
        <p class="text-gray-400">Discover and follow the best esports teams in Tunisia</p>
    </div>

    <!-- Search -->
    <div class="container mx-auto px-4 mb-8">
        <div class="relative max-w-md">
            <svg class="absolute left-3 top-3 h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
                type="text"
                placeholder="Search teams..."
                class="w-full pl-10 pr-4 py-2 rounded-md bg-[#1e1e2e] border border-[#D4AF37]/20 focus:outline-none focus:border-[#D4AF37]/50"
            />
        </div>
    </div>

    <!-- Teams Grid -->
     <section class="container mx-auto px-4 py-16">
         <div class="mb-12 text-center">
        <h2 class="text-4xl font-bold mb-4">Teams</h2>
        <p class="text-gray-400">The teams in our platform</p>
    </div>

    {% if top_teams is defined and top_teams|length > 0 %}
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 justify-items-center">
            {% for team in top_teams|slice(0, 4) %}
                <div class="border border-[#D4AF37]/20 rounded-lg bg-[#12121a] p-6 hover:border-[#D4AF37]/50 transition-all w-full max-w-md">
                    <h3 class="text-lg font-bold mb-4">{{ team.teamName }}</h3>
                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-gray-400">Owner</span>
                            <span class="font-medium">{{ team.user ? team.user.username : 'N/A' }}</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-400">Members</span>
                            <span class="font-medium">{{ team.teamPlayers|length }}</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-400">Created</span>
                            <span class="font-medium">{{ team.creationDate ? team.creationDate|date('Y-m-d') : 'N/A' }}</span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="text-center py-12 bg-[#12121a] rounded-lg border border-[#D4AF37]/20">
            <p class="text-gray-400">No teams yet.</p>
        </div>
    {% endif %}
    </section>
    <!-- Team Spotlight -->
    <div class="container mx-auto px-4 mb-16">
        <div class="border border-[#D4AF37]/20 rounded-lg bg-gradient-to-br from-[#12121a] to-[#1e1e2e] p-8">
            <div class="flex flex-col md:flex-row items-start gap-8">
                <div class="flex h-24 w-24 items-center justify-center rounded-xl bg-gradient-to-br from-[#D4AF37] to-[#B8941F] flex-shrink-0">
                    <svg class="h-12 w-12 text-[#0a0a0f]" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                </div>
                <div class="flex-1">
                    <div class="inline-block px-3 py-1 rounded-full bg-[#D4AF37]/20 text-[#D4AF37] text-xs font-medium mb-2">Team Spotlight</div>
                    <h2 class="text-2xl font-bold mb-4">Phoenicians Elite</h2>
                    <p class="text-gray-400 mb-6">
                        Reigning champions with an impressive 90% win rate. Known for their strategic gameplay and exceptional teamwork.
                    </p>
                    <div class="flex gap-8">
                        <div>
                            <div class="text-2xl font-bold text-[#D4AF37]">45</div>
                            <div class="text-sm text-gray-400">Wins</div>
                        </div>
                        <div>
                            <div class="text-2xl font-bold text-[#D4AF37]">5</div>
                            <div class="text-sm text-gray-400">Losses</div>
                        </div>
                        <div>
                            <div class="text-2xl font-bold text-[#D4AF37]">8</div>
                            <div class="text-sm text-gray-400">Tournaments Won</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-[#D4AF37]/20 bg-[#0a0a0f]">
        <div class="container mx-auto px-4 py-12">
            <div class="grid md:grid-cols-4 gap-8 mb-8">
                <div>
                    <h3 class="font-bold text-[#D4AF37] mb-4">CarthageGG</h3>
                    <p class="text-gray-400 text-sm">Tunisia's premier esports platform</p>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Platform</h4>
                    <ul class="space-y-2 text-gray-400 text-sm">
                        <li><a href="{{ path('app_tournaments') }}" class="hover:text-[#D4AF37]">Tournaments</a></li>
                        <li><a href="{{ path('app_teams') }}" class="hover:text-[#D4AF37]">Teams</a></li>
                        <li><a href="{{ path('app_matches') }}" class="hover:text-[#D4AF37]">Matches</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Compete</h4>
                    <ul class="space-y-2 text-gray-400 text-sm">
                        <li><a href="{{ path('app_leaderboard') }}" class="hover:text-[#D4AF37]">Leaderboard</a></li>
                        <li><a href="{{ path('app_register') }}" class="hover:text-[#D4AF37]">Register</a></li>
                        <li><a href="{{ path('app_support') }}" class="hover:text-[#D4AF37]">Support</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Follow</h4>
                    <div class="flex space-x-4">
                        <a href="#" class="text-gray-400 hover:text-[#D4AF37]">Twitter</a>
                        <a href="#" class="text-gray-400 hover:text-[#D4AF37]">Discord</a>
                        <a href="#" class="text-gray-400 hover:text-[#D4AF37]">YouTube</a>
                    </div>
                </div>
            </div>
            <div class="border-t border-[#D4AF37]/20 pt-8 text-center text-gray-400 text-sm">
                <p>&copy; 2026 CarthageGG. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="{{ asset('main.js') }}"></script>
</body>
</html>
{% endblock %}

