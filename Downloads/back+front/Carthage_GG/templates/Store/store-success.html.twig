=<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Complete | CarthageGG</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="{{ asset('styles/styles.css') }}">
</head>
<body class="bg-[#0a0a0f] text-[#e4e4e7]">
    <nav class="bg-[#12121a] border-b border-[#D4AF37]/20 sticky top-0 z-50">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center gap-2">
                <img src="{{ asset('images/zz.png') }}" alt="CarthageGG Logo" class="w-14 h-14 rounded-lg shadow-lg object-cover">
                <span class="font-bold text-[#D4AF37]">CarthageGG</span>
            </div>
            <div class="flex gap-8 items-center">
                <a href="{{ path('app_index') }}" class="hover:text-[#D4AF37] transition">Home</a>
                <a href="{{ path('app_store') }}" class="hover:text-[#D4AF37] transition">Store</a>
            </div>
        </div>
    </nav>

    <div class="container mx-auto px-4 py-12 max-w-2xl">
        <div class="border border-[#D4AF37]/20 rounded-lg bg-[#12121a] p-8 text-center">
            <h1 class="text-3xl font-bold text-[#D4AF37] mb-4">Payment Successful</h1>
            <p class="text-gray-400 mb-6">Thank you for your purchase. Your order is confirmed.</p>
            {% if receipt_url %}
                <a href="{{ receipt_url }}" target="_blank" rel="noopener" class="inline-block px-6 py-3 bg-[#3B82F6] text-white rounded-lg hover:bg-[#2563EB] transition font-bold mb-4">View Stripe Receipt</a>
            {% else %}
                <p class="text-gray-400 mb-4">Receipt link is not available. You will receive an email receipt if enabled.</p>
            {% endif %}
            <div>
                <a href="{{ path('app_store') }}" class="px-6 py-3 bg-[#D4AF37] text-[#0a0a0f] rounded-lg hover:bg-[#B8941F] transition font-bold">Continue Shopping</a>
            </div>
        </div>
    </div>
</body>
</html>
