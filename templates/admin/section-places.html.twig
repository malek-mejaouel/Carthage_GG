<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Places | CarthageGG</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-[#0a0a0f] text-[#e4e4e7]">
    {% include 'admin/_sidebar.html.twig' %}
    <div class="lg:ml-64 flex flex-col min-h-screen">
    <main class="flex-1 p-6">
    <div class="container mx-auto px-6 py-8">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-2xl font-bold text-white">Places</h1>
            <a href="{{ path('app_admin_dashboard') }}" class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded-lg font-bold hover:bg-[#B8941F] transition">Back to Dashboard</a>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            <div class="lg:col-span-2 bg-[#12121a] rounded-xl border border-[#D4AF37]/10 p-6">
                <h3 class="text-lg font-bold text-white mb-4">Geographic Distribution</h3>
                <div class="relative h-80">
                    <canvas id="geoChart"></canvas>
                </div>
            </div>
            <div class="bg-[#12121a] rounded-xl border border-[#D4AF37]/10 p-6">
                <h3 class="text-lg font-bold text-white mb-4">Top Regions</h3>
                <div class="relative h-64">
                    <canvas id="regionsChart"></canvas>
                </div>
            </div>
        </div>
        <div class="bg-[#12121a] rounded-xl border border-[#D4AF37]/10 overflow-hidden">
            <div class="p-6 border-b border-[#D4AF37]/10 flex justify-between items-center">
                <h3 class="text-lg font-bold text-white">Locations</h3>
                <div class="flex gap-2">
                    <button class="px-4 py-2 bg-[#D4AF37]/10 text-[#D4AF37] rounded-lg text-sm font-medium hover:bg-[#D4AF37]/20 transition">Export</button>
                    <button class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded-lg text-sm font-bold hover:bg-[#B8941F] transition">Add</button>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-400">
                    <thead class="bg-[#1a1a24] text-[#D4AF37] uppercase font-bold text-xs">
                        <tr>
                            <th class="px-6 py-4">City</th>
                            <th class="px-6 py-4">Country</th>
                            <th class="px-6 py-4">Users</th>
                            <th class="px-6 py-4">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#D4AF37]/10">
                        <tr class="table-row-hover transition">
                            <td class="px-6 py-4 font-medium text-white">Tunis</td>
                            <td class="px-6 py-4">Tunisia</td>
                            <td class="px-6 py-4">12,500</td>
                            <td class="px-6 py-4"><span class="px-3 py-1 bg-green-500/10 text-green-500 rounded-full text-xs">Active</span></td>
                        </tr>
                        <tr class="table-row-hover transition">
                            <td class="px-6 py-4 font-medium text-white">Paris</td>
                            <td class="px-6 py-4">France</td>
                            <td class="px-6 py-4">9,800</td>
                            <td class="px-6 py-4"><span class="px-3 py-1 bg-yellow-500/10 text-yellow-500 rounded-full text-xs">Growing</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    </main>
    </div>
    <script>
        const geoCtx = document.getElementById('geoChart');
        new Chart(geoCtx, {
            type: 'line',
            data: {
                labels: ['NA', 'EU', 'MEA', 'APAC'],
                datasets: [{ label: 'Users', data: [35000, 28000, 22000, 30000], borderColor: '#D4AF37', backgroundColor: 'rgba(212,175,55,0.1)' }]
            },
            options: { scales: { x: { ticks: { color: '#9CA3AF' } }, y: { ticks: { color: '#9CA3AF' } } } }
        });
        const regionsCtx = document.getElementById('regionsChart');
        new Chart(regionsCtx, {
            type: 'pie',
            data: {
                labels: ['NA', 'EU', 'MEA', 'APAC'],
                datasets: [{ data: [35, 28, 22, 30], backgroundColor: ['#3B82F6', '#10B981', '#A855F7', '#F59E0B'] }]
            },
            options: { plugins: { legend: { labels: { color: '#e4e4e7' } } } }
        });
    </script>
</script>
<script src="{{ asset('js/admin-dashboard.js') }}"></script>
</body>
</html>
