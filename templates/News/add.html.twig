{% extends "base.html.twig" %}

{% block title %}Add News - CarthageGG{% endblock %}

{% block content %}
<section class="py-12 px-6 bg-gradient-to-b from-[#0a0a0f] to-[#1a1a24]">
    <div class="container mx-auto max-w-2xl">
        <!-- Back Button -->
        <a href="{{ path('app_news_list') }}" class="inline-flex items-center text-[#D4AF37] hover:text-[#B8941F] transition mb-8">
            ← Back to News
        </a>

        <!-- Form Header -->
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-white mb-2">Create News Article</h1>
            <p class="text-gray-400">Share the latest news and updates with the community</p>
        </div>

        <!-- Error Messages -->
        {% if errors %}
            <div class="mb-6 p-4 bg-red-500/10 border border-red-500/20 rounded-lg">
                <h3 class="text-red-500 font-bold mb-2">Please fix the following errors:</h3>
                <ul class="list-disc list-inside text-red-400 space-y-1">
                    {% for field, message in errors %}
                        <li>{{ message }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <!-- Success Message -->
        {% if success %}
            <div class="mb-6 p-4 bg-green-500/10 border border-green-500/20 rounded-lg text-green-500">
                ✓ {{ successMessage ?? 'News article published successfully!' }}
            </div>
        {% endif %}

        <!-- Form -->
        <form action="{{ path('app_news_add') }}" method="POST" enctype="multipart/form-data" class="bg-[#12121a] rounded-xl border border-[#D4AF37]/10 p-8">
            <!-- Title Field -->
            <div class="mb-6">
                <label for="titre" class="block text-sm font-semibold text-white mb-2">Title *</label>
                <input 
                    type="text" 
                    id="titre" 
                    name="titre" 
                    value="{{ titre }}" 
                    placeholder="Enter article title" 
                    class="w-full px-4 py-3 bg-[#1a1a24] border border-[#D4AF37]/20 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-[#D4AF37] transition"
                >
                {% if errors.title %}<p class="text-red-400 text-sm mt-1">{{ errors.title }}</p>{% endif %}
            </div>

            <!-- Category Field -->
            <div class="mb-6">
                <label for="categorie" class="block text-sm font-semibold text-white mb-2">Category *</label>
                <select 
                    id="categorie" 
                    name="categorie"
                    class="w-full px-4 py-3 bg-[#1a1a24] border border-[#D4AF37]/20 rounded-lg text-white focus:outline-none focus:border-[#D4AF37] transition"
                >
                    <option value="">Select a category</option>
                    <option value="tournaments" {% if categorie == 'tournaments' %}selected{% endif %}>Tournaments</option>
                    <option value="matches" {% if categorie == 'matches' %}selected{% endif %}>Matches</option>
                    <option value="players" {% if categorie == 'players' %}selected{% endif %}>Players</option>
                    <option value="events" {% if categorie == 'events' %}selected{% endif %}>Events</option>
                    <option value="updates" {% if categorie == 'updates' %}selected{% endif %}>Updates</option>
                    <option value="announcements" {% if categorie == 'announcements' %}selected{% endif %}>Announcements</option>
                    <option value="results" {% if categorie == 'results' %}selected{% endif %}>Results</option>
                    <option value="statistics" {% if categorie == 'statistics' %}selected{% endif %}>Statistics</option>
                </select>
                {% if errors.category %}<p class="text-red-400 text-sm mt-1">{{ errors.category }}</p>{% endif %}
            </div>

            <!-- Content Field -->
            <div class="mb-6">
                <label for="contenu" class="block text-sm font-semibold text-white mb-2">Content *</label>
                <textarea 
                    id="contenu" 
                    name="contenu" 
                    placeholder="Write your news article here..." 
                    rows="10"
                    class="w-full px-4 py-3 bg-[#1a1a24] border border-[#D4AF37]/20 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-[#D4AF37] transition resize-none"
                >{{ contenu }}</textarea>
                {% if errors.content %}<p class="text-red-400 text-sm mt-1">{{ errors.content }}</p>{% endif %}
            </div>

            <!-- Image Field -->
            <div class="mb-8">
                <label for="image" class="block text-sm font-semibold text-white mb-2">Featured Image (Optional)</label>
                <div class="relative">
                    <input 
                        type="file" 
                        id="image" 
                        name="image" 
                        accept="image/*"
                        class="w-full px-4 py-3 bg-[#1a1a24] border border-[#D4AF37]/20 rounded-lg text-white focus:outline-none focus:border-[#D4AF37] transition cursor-pointer"
                    >
                </div>
                {% if errors.image %}<p class="text-red-400 text-sm mt-1">{{ errors.image }}</p>{% endif %}
            </div>

            <!-- Submit Button -->
            <div class="flex gap-4">
                <button 
                    type="submit" 
                    class="flex-1 px-6 py-3 bg-[#D4AF37] text-[#0a0a0f] rounded-lg font-bold text-lg hover:bg-[#B8941F] transition"
                >
                    Publish News
                </button>
                <a 
                    href="{{ path('app_news_list') }}" 
                    class="flex-1 px-6 py-3 bg-gray-700 text-white rounded-lg font-bold text-lg hover:bg-gray-600 transition text-center"
                >
                    Cancel
                </a>
            </div>

            <!-- Info Text -->
            <p class="text-gray-400 text-sm mt-6">
                * Required fields. Your article will be published immediately after submission.
            </p>
        </form>
    </div>
</section>
{% endblock %}
