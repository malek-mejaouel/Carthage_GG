<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tournaments - CarthageGG</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="{{ asset('assets/styles/styles.css') }}" />
</head>
<body class="bg-[#0a0a0f] text-[#e4e4e7]">
    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 border-b border-[#D4AF37]/20 bg-[#0a0a0f]/95 backdrop-blur-sm">
        <div class="container mx-auto px-4">
            <div class="flex h-16 items-center justify-between">
                <a href="{{ path('app_index') }}" class="flex items-center space-x-2">
                    <img src="{{ asset('assets/images/zz.png') }}" alt="CarthageGG Logo" class="h-14 w-14 rounded-lg shadow-lg object-cover">
                    <span class="text-2xl font-bold text-[#D4AF37]">Carthage</span>
                    <span class="text-2xl font-bold text-white">GG</span>
                </a>
                <div class="hidden md:flex items-center space-x-1">
                    <a href="{{ path('tournament_index') }}" class="px-4 py-2 rounded-md bg-[#D4AF37]/10 text-[#D4AF37]">Tournaments</a>
                    <a href="{{ path('team_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Teams</a>
                    <a href="{{ path('match_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Matches</a>
                    <a href="{{ path('match_player_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">MatchPlayers</a>
                    <a href="{{ path('team_player_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">TeamPlayers</a>
                    <a href="{{ path('game_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Games</a>
                </div>
                <div class="flex items-center space-x-3">
                    <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-white px-4 py-2 text-sm font-medium">Login</a>
                    <a href="{{ path('app_dashboard') }}" class="px-4 py-2 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] text-sm font-medium">Dashboard</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <div class="container mx-auto px-4 py-8">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-4xl font-bold mb-2">Tournaments</h1>
                <p class="text-gray-400">Manage and explore all esports tournaments</p>
            </div>
            <a href="{{ path('tournament_new') }}" class="px-6 py-2 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] font-medium hover:opacity-90">+ Create Tournament</a>
        </div>
    </div>

    <!-- Tournaments Grid -->
    <div class="container mx-auto px-4 mb-12">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-2xl font-bold">All Tournaments</h3>
            <div class="flex space-x-2">
                <!-- Search Input -->
                <div class="relative">
                    <input type="text" 
                           id="tournamentSearch" 
                           placeholder="Search tournaments..." 
                           class="pl-10 pr-4 py-2 rounded-md bg-[#12121a] border border-[#D4AF37]/30 text-white text-sm w-64 focus:outline-none focus:border-[#D4AF37]">
                    <svg class="w-5 h-5 absolute left-3 top-2.5 text-gray-400" 
                         fill="none" 
                         stroke="currentColor" 
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round" 
                              stroke-linejoin="round" 
                              stroke-width="2" 
                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
                
                <!-- Sort Dropdown - FIXED VALUES -->
                <select id="sortSelect" class="px-4 py-2 rounded-md bg-[#12121a] border border-[#D4AF37]/30 text-white text-sm">
                    <option value="date_desc">Date (Newest First)</option>
                    <option value="date_asc">Date (Oldest First)</option>
                    <option value="prize_desc">Prize Pool (High to Low)</option>
                    <option value="prize_asc">Prize Pool (Low to High)</option>
                </select>
            </div>
        </div>

        {% if tournaments|length > 0 %}
            <div id="tournamentsContainer" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {% for t in tournaments %}
                    <div class="tournament-card border border-[#D4AF37]/20 rounded-lg bg-[#12121a] overflow-hidden hover:border-[#D4AF37]/50 transition-all hover:transform hover:scale-[1.02]"
                         data-name="{{ t.getTournamentName()|lower }}"
                         data-game="{{ t.getGame() ? t.getGame().getName()|lower : '' }}"
                         data-date="{{ t.getStartDate() ? t.getStartDate()|date('Y-m-d') : '' }}"
                         data-prize="{{ t.getPrizePool()|default(10000)|replace({',': ''}) }}">
                        <!-- Gradient Top Bar -->
                        <div class="h-2 bg-gradient-to-r from-[#D4AF37] to-[#B8941F]"></div>

                        <!-- Card Content -->
                        <div class="p-6">
                            <!-- Status Badge -->
                            <div class="flex items-center justify-between mb-4">
                                <span class="inline-block px-3 py-1 rounded-full bg-[#D4AF37]/20 text-[#D4AF37] text-xs font-bold">TOURNAMENT</span>
                                <span class="text-xs text-gray-400">{{ t.getStartDate() ? t.getStartDate()|date('Y-m-d') : 'TBD' }}</span>
                            </div>

                            <!-- Title -->
                            <h3 class="text-lg font-bold mb-3">{{ t.getTournamentName() }}</h3>

                            <!-- Tournament Info -->
                            <div class="space-y-2 text-sm mb-4">
                                <div class="flex justify-between">
                                    <span class="text-gray-400">Game</span>
                                    <span class="font-bold">{{ t.getGame() ? t.getGame().getName() : 'N/A' }}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-400">Date Range</span>
                                    <span>{{ t.getStartDate() ? t.getStartDate()|date('M d') : 'TBD' }} - {{ t.getEndDate() ? t.getEndDate()|date('M d') : 'TBD' }}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-400">Prize Pool</span>
                                    <span class="text-[#D4AF37]">${{ t.getPrizePool()|default('10,000') }}</span>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="flex gap-2">
                                <a href="{{ path('tournament_show', {id: t.getTournamentId()}) }}" class="flex-1 px-3 py-2 rounded-md bg-[#D4AF37]/10 text-[#D4AF37] hover:bg-[#D4AF37]/20 text-sm font-medium flex items-center justify-center space-x-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                    </svg>
                                    <span>View</span>
                                </a>
                                <a href="{{ path('tournament_edit', {id: t.getTournamentId()}) }}" class="flex-1 px-3 py-2 rounded-md border border-gray-400 text-gray-300 hover:bg-[#1e1e2e] text-sm font-medium flex items-center justify-center space-x-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                    <span>Edit</span>
                                </a>
                                <form method="post" action="{{ path('tournament_delete', {id: t.getTournamentId()}) }}" style="flex: 1" onsubmit="return confirm('Delete this tournament?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ t.getTournamentId()) }}">
                                    <button type="submit" class="w-full px-3 py-2 rounded-md border border-red-600 text-red-600 hover:bg-red-600/10 text-sm font-medium flex items-center justify-center space-x-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                        <span>Delete</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            
            <!-- No Results Message -->
            <div id="noResults" class="text-center py-12 hidden">
                <p class="text-gray-400 mb-4">No tournaments found matching your search</p>
                <button id="clearSearch" class="px-6 py-2 rounded-md bg-[#D4AF37]/10 text-[#D4AF37] font-medium hover:bg-[#D4AF37]/20">
                    Clear Search
                </button>
            </div>
            
        {% else %}
            <div class="text-center py-12">
                <p class="text-gray-400 mb-4">No tournaments found</p>
                <a href="{{ path('tournament_new') }}" class="px-6 py-2 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] font-medium hover:opacity-90">Create First Tournament</a>
            </div>
        {% endif %}
    </div>

    <!-- Pagination -->
    {% if total is defined and total > perPage %}
        <div class="container mx-auto px-4 pb-12 text-center text-gray-400">
            <p>Page {{ page }} of {{ ((total + perPage - 1) // perPage) }} — Total: {{ total }} tournaments</p>
        </div>
    {% endif %}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Search and Sort functionality
            const searchInput = document.getElementById('tournamentSearch');
            const sortSelect = document.getElementById('sortSelect');
            const tournamentCards = document.querySelectorAll('.tournament-card');
            const tournamentsContainer = document.getElementById('tournamentsContainer');
            const noResults = document.getElementById('noResults');
            const clearSearch = document.getElementById('clearSearch');

            // Function to filter and sort tournaments
            function updateTournaments() {
                const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';
                const sortValue = sortSelect ? sortSelect.value : 'date_desc';
                
                let cards = Array.from(tournamentCards);
                
                // Filter by search term
                if (searchTerm) {
                    cards = cards.filter(card => {
                        const name = card.getAttribute('data-name') || '';
                        const game = card.getAttribute('data-game') || '';
                        return name.includes(searchTerm) || game.includes(searchTerm);
                    });
                }
                
                // Sort the cards
                cards.sort((a, b) => {
                    switch(sortValue) {
                        case 'date_desc':
                            // Newest first
                            const dateA = a.getAttribute('data-date') || '1970-01-01';
                            const dateB = b.getAttribute('data-date') || '1970-01-01';
                            return new Date(dateB) - new Date(dateA);
                            
                        case 'date_asc':
                            // Oldest first
                            const dateA_asc = a.getAttribute('data-date') || '9999-12-31';
                            const dateB_asc = b.getAttribute('data-date') || '9999-12-31';
                            return new Date(dateA_asc) - new Date(dateB_asc);
                            
                        case 'prize_desc':
                            // High to low
                            const prizeA = parseFloat(a.getAttribute('data-prize') || 0);
                            const prizeB = parseFloat(b.getAttribute('data-prize') || 0);
                            return prizeB - prizeA;
                            
                        case 'prize_asc':
                            // Low to high
                            const prizeA_asc = parseFloat(a.getAttribute('data-prize') || 0);
                            const prizeB_asc = parseFloat(b.getAttribute('data-prize') || 0);
                            return prizeA_asc - prizeB_asc;
                            
                        default:
                            return 0;
                    }
                });
                
                // Update visibility and order
                let visibleCount = 0;
                
                // First hide all cards
                tournamentCards.forEach(card => {
                    card.style.display = 'none';
                });
                
                // Then show and reorder visible cards
                cards.forEach(card => {
                    card.style.display = 'block';
                    tournamentsContainer.appendChild(card);
                    visibleCount++;
                });
                
                // Show/hide no results message
                if (visibleCount === 0 && searchTerm) {
                    if (noResults) noResults.classList.remove('hidden');
                    if (tournamentsContainer) tournamentsContainer.classList.add('hidden');
                } else {
                    if (noResults) noResults.classList.add('hidden');
                    if (tournamentsContainer) tournamentsContainer.classList.remove('hidden');
                }
            }
            
            // Event listeners
            if (searchInput) {
                searchInput.addEventListener('input', updateTournaments);
            }
            
            if (sortSelect) {
                sortSelect.addEventListener('change', updateTournaments);
            }
            
            if (clearSearch) {
                clearSearch.addEventListener('click', function() {
                    if (searchInput) searchInput.value = '';
                    updateTournaments();
                });
            }
            
            // Initialize
            updateTournaments();
        });
    </script>
</body>
</html>