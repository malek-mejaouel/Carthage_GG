<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>User</title></head>
<body>
    <h1>User #{{ user.getUserId() }}</h1>
    <p><a href="{{ path('user_index') }}">Back to list</a> | <a href="{{ path('user_edit', {id: user.getUserId()}) }}">Edit</a></p>

    <ul>
        <li>Username: {{ user.getUsername() }}</li>
        <li>Email: {{ user.getEmail() }}</li>
        <li>First name: {{ user.getFirstname() }}</li>
        <li>Last name: {{ user.getLastname() }}</li>
        <li>Is active: {{ user.isActive() ? 'yes' : 'no' }}</li>
        <li>Created: {{ user.getCreatedAt() ? user.getCreatedAt().format('Y-m-d H:i') : '' }}</li>
    </ul>

    <form method="post" action="{{ path('user_delete', {id: user.getUserId()}) }}" onsubmit="return confirm('Delete?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.getUserId()) }}">
        <button type="submit">Delete</button>
    </form>
</body>
</html>
