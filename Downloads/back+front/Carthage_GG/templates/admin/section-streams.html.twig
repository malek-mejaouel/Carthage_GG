<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Streams | CarthageGG</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-[#0a0a0f] text-[#e4e4e7]">
    {% include 'admin/_sidebar.html.twig' %}
    <div class="lg:ml-64 flex flex-col min-h-screen">
        <main class="flex-1 p-6">
            <div class="container mx-auto px-6 py-8">
                <div class="flex items-center justify-between mb-6">
                    <h1 class="text-2xl font-bold text-white">Streams</h1>
                    <a href="{{ path('app_admin_dashboard') }}" class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded-lg font-bold hover:bg-[#B8941F] transition">Back to Dashboard</a>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-[#12121a] rounded-xl border border-[#D4AF37]/10 p-6">
                        <h3 class="text-lg font-bold text-white mb-4">Add New Stream</h3>
                        <form method="post" action="{{ path('app_admin_streams_new') }}" enctype="multipart/form-data" class="space-y-4">
                            <div>
                                <label class="block text-sm text-gray-300 mb-1">Name</label>
                                <input name="stream[title]" type="text" class="w-full px-3 py-2 bg-[#0f0f16] border border-[#D4AF37]/20 rounded text-[#e4e4e7]" required>
                            </div>
                            <div>
                                <label class="block text-sm text-gray-300 mb-1">URL</label>
                                <input name="stream[url]" type="text" placeholder="https://www.twitch.tv/yourchannel or https://youtu.be/VIDEOID" class="w-full px-3 py-2 bg-[#0f0f16] border border-[#D4AF37]/20 rounded text-[#e4e4e7]" required>
                            </div>
                            <div>
                                <label class="block text-sm text-gray-300 mb-1">Thumbnail Image</label>
                                <input name="stream[thumbnail]" type="file" accept="image/*" class="w-full px-3 py-2 bg-[#0f0f16] border border-[#D4AF37]/20 rounded text-[#e4e4e7]">
                            </div>
                            <div>
                                <button class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded hover:bg-[#B8941F]">Add Stream</button>
                            </div>
                        </form>
                    </div>
                    <div class="bg-[#12121a] rounded-xl border border-[#D4AF37]/10 p-6">
                        <h3 class="text-lg font-bold text-white mb-4">Existing Streams</h3>
                        <div class="grid grid-cols-1 gap-4">
                            {% for s in streams %}
                                <div class="flex gap-3 items-center p-3 rounded border border-[#D4AF37]/20 bg-[#0f0f16]">
                                    <div class="w-20 h-14 bg-[#12121a] rounded overflow-hidden">
                                        {% if s.thumbnail %}
                                            {% set thumb = s.thumbnail %}
                                            {% if thumb|slice(0,4) == 'http' %}
                                                {% set src = thumb %}
                                            {% elseif thumb|slice(0,1) == '/' %}
                                                {% set src = asset(thumb|slice(1)) %}
                                            {% else %}
                                                {% set src = asset('uploads/streams/' ~ thumb) %}
                                            {% endif %}
                                            <img src="{{ src }}" alt="{{ s.title }}" class="w-full h-full object-cover">
                                        {% else %}
                                            <div class="w-full h-full flex items-center justify-center text-xs text-gray-500">No thumb</div>
                                        {% endif %}
                                    </div>
                                    <div class="flex-1">
                                        <p class="font-semibold">{{ s.title }}</p>
                                        <p class="text-xs text-gray-400">
                                            {{ s.platform|capitalize }} • 
                                            {% if s.platform == 'twitch' %}{{ s.channelName ?? '—' }}{% else %}{{ s.youtubeVideoId ?? '—' }}{% endif %}
                                        </p>
                                    </div>
                                    <div class="text-right">
                                        <span class="text-sm {{ s.isLive ? 'text-green-400' : 'text-gray-400' }}">{{ s.isLive ? 'LIVE' : 'OFFLINE' }}</span><br>
                                        <div class="flex items-center gap-3 justify-end mt-2">
                                            <a href="{{ path('app_streams_show', { id: s.streamId }) }}" class="text-[#D4AF37] text-sm hover:underline">View</a>
                                            <a href="{{ path('app_admin_streams_edit', { id: s.streamId }) }}" class="text-blue-400 text-sm hover:underline">Edit</a>
                                            <form method="post" action="{{ path('app_admin_streams_delete', { id: s.streamId }) }}" onsubmit="return confirm('Delete this stream?');">
                                                <button class="text-red-400 text-sm hover:underline" type="submit">Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            {% else %}
                                <p class="text-gray-400">No streams yet.</p>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <script src="{{ asset('js/admin-dashboard.js') }}"></script>
</body>
</html>
