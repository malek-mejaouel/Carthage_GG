<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Game - CarthageGG</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom form styling to match CarthageGG theme */
        input, select, textarea {
            background-color: #0a0a0f;
            border: 1px solid rgba(212, 175, 55, 0.2);
            color: #e4e4e7;
        }
        
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #D4AF37;
            box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.2);
        }
        
        label {
            color: #D4AF37;
            font-weight: 500;
        }
        
        .form-checkbox {
            accent-color: #D4AF37;
        }
    </style>
</head>
<body class="bg-[#0a0a0f] text-[#e4e4e7] min-h-screen">
    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 border-b border-[#D4AF37]/20 bg-[#0a0a0f]/95 backdrop-blur-sm">
        <div class="container mx-auto px-4">
            <div class="flex h-16 items-center justify-between">
                <a href="{{ path('app_index') }}" class="flex items-center space-x-2">
                    <img src="{{ asset('assets/images/zz.png') }}" alt="CarthageGG Logo" class="h-14 w-14 rounded-lg shadow-lg object-cover">
                    <span class="text-2xl font-bold text-[#D4AF37]">Carthage</span>
                    <span class="text-2xl font-bold text-white">GG</span>
                </a>
                <div class="hidden md:flex items-center space-x-1">
                    <a href="{{ path('tournament_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Tournaments</a>
                    <a href="{{ path('team_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Teams</a>
                    <a href="{{ path('match_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Matches</a>
                    <a href="{{ path('match_player_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">MatchPlayer</a>
                    <a href="{{ path('team_player_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">TeamPlayer</a>
                    <a href="{{ path('game_index') }}" class="px-4 py-2 rounded-md bg-[#D4AF37]/20 text-[#D4AF37] hover:bg-[#D4AF37]/30">Game</a>
                </div>
                <div class="flex items-center space-x-3">
                    <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-white px-4 py-2 text-sm font-medium">Login</a>
                    <a href="{{ path('app_dashboard') }}" class="px-4 py-2 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] text-sm font-medium">Dashboard</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-8">
        <!-- Header Section -->
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-4xl font-bold text-[#D4AF37] mb-2">Edit Game</h1>
                    <p class="text-gray-400">Update game information for {{ game.getName() ?? 'this game' }}</p>
                </div>
                <div class="flex space-x-3">
                    <a href="{{ path('game_index') }}" class="inline-flex items-center px-6 py-3 rounded-md border-2 border-[#D4AF37] text-[#D4AF37] font-medium hover:bg-[#D4AF37]/10 transition-colors">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        Back to List
                    </a>
                    <a href="{{ path('game_show', {id: game.getGameId()}) }}" class="inline-flex items-center px-6 py-3 rounded-md bg-blue-500/20 text-blue-400 hover:bg-blue-500/30 font-medium transition-colors">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                        View Game
                    </a>
                </div>
            </div>
        </div>

        <!-- Form Container -->
        <div class="max-w-2xl mx-auto">
            <div class="bg-[#12121a] border border-[#D4AF37]/20 rounded-lg p-6 mb-8">
                {{ form_start(form, { 'attr': { 'class': 'space-y-6' } }) }}
                
                <!-- Form Fields Styled -->
                <div class="space-y-4">
                    {% for child in form %}
                        {% if child.vars.name != '_token' %}
                            <div class="space-y-2">
                                {{ form_label(child, null, { 'label_attr': { 'class': 'block text-sm font-medium text-[#D4AF37]' } }) }}
                                
                                {% if child.vars.block_prefixes[1] == 'textarea' %}
                                    {{ form_widget(child, { 'attr': { 
                                        'class': 'w-full px-4 py-3 bg-[#0a0a0f] border border-[#D4AF37]/20 rounded-md focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] focus:outline-none text-[#e4e4e7]',
                                        'rows': '4'
                                    } }) }}
                                {% elseif child.vars.block_prefixes[1] == 'checkbox' %}
                                    <div class="flex items-center">
                                        {{ form_widget(child, { 'attr': { 
                                            'class': 'w-5 h-5 rounded border-[#D4AF37]/20 bg-[#0a0a0f] text-[#D4AF37] focus:ring-[#D4AF37] focus:ring-1'
                                        } }) }}
                                        <span class="ml-2 text-gray-300">{{ child.vars.label }}</span>
                                    </div>
                                {% elseif child.vars.block_prefixes[1] == 'choice' %}
                                    {{ form_widget(child, { 'attr': { 
                                        'class': 'w-full px-4 py-3 bg-[#0a0a0f] border border-[#D4AF37]/20 rounded-md focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] focus:outline-none text-[#e4e4e7]'
                                    } }) }}
                                {% else %}
                                    {{ form_widget(child, { 'attr': { 
                                        'class': 'w-full px-4 py-3 bg-[#0a0a0f] border border-[#D4AF37]/20 rounded-md focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] focus:outline-none text-[#e4e4e7]'
                                    } }) }}
                                {% endif %}
                                
                                {{ form_errors(child, { 'attr': { 'class': 'text-red-400 text-sm mt-1' } }) }}
                                {% if child.vars.help is defined %}
                                    <p class="text-gray-400 text-sm">{{ child.vars.help }}</p>
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>

                <!-- Form Actions -->
                <div class="pt-6 border-t border-[#D4AF37]/20 flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">
                    <div class="text-sm text-gray-400">
                        <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                        </svg>
                        Update the game information below
                    </div>
                    <div class="flex space-x-3">
                        <a href="{{ path('game_index') }}" class="px-6 py-3 rounded-md border-2 border-[#D4AF37] text-[#D4AF37] font-medium hover:bg-[#D4AF37]/10 transition-colors">
                            Cancel
                        </a>
                        <button type="submit" class="inline-flex items-center px-6 py-3 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] font-medium hover:opacity-90 transition-opacity">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            Save Changes
                        </button>
                    </div>
                </div>
                
                {{ form_end(form) }}
            </div>

            <!-- Game Details Card - Fixed version without releaseYear -->
            <div class="bg-[#12121a] border border-[#D4AF37]/20 rounded-lg p-6 mb-6">
                <h3 class="text-lg font-bold text-[#D4AF37] mb-4">📋 Game Details</h3>
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <h4 class="font-medium text-gray-300 mb-2">Current Information</h4>
                        <ul class="space-y-2 text-sm text-gray-400">
                            <li><span class="text-[#D4AF37]">ID:</span> {{ game.getGameId() }}</li>
                            <li><span class="text-[#D4AF37]">Name:</span> {{ game.getName() }}</li>
                            <li><span class="text-[#D4AF37]">Genre:</span> {{ game.getGenre() }}</li>
                            {# Only display properties if they exist #}
                            {% if game.releaseYear is defined %}
                                <li><span class="text-[#D4AF37]">Release Year:</span> {{ game.releaseYear }}</li>
                            {% endif %}
                            {% if game.description is defined and game.description is not empty %}
                                <li><span class="text-[#D4AF37]">Description:</span> {{ game.description|slice(0, 100) }}...</li>
                            {% endif %}
                            {% if game.createdAt is defined %}
                                <li><span class="text-[#D4AF37]">Created:</span> {{ game.createdAt|date('Y-m-d') }}</li>
                            {% endif %}
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-medium text-gray-300 mb-2">Editing Tips</h4>
                        <ul class="space-y-2 text-sm text-gray-400">
                            <li class="flex items-start">
                                <svg class="w-4 h-4 text-[#D4AF37] mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"></path>
                                </svg>
                                Keep game names consistent across tournaments
                            </li>
                            <li class="flex items-start">
                                <svg class="w-4 h-4 text-[#D4AF37] mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"></path>
                                </svg>
                                Update genres to reflect the primary competitive mode
                            </li>
                            <li class="flex items-start">
                                <svg class="w-4 h-4 text-[#D4AF37] mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"></path>
                                </svg>
                                Add detailed descriptions for better tournament categorization
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="bg-[#12121a] border border-[#D4AF37]/20 rounded-lg p-6">
                <h3 class="text-lg font-bold text-[#D4AF37] mb-4">⚡ Quick Actions</h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <a href="{{ path('game_show', {id: game.getGameId()}) }}" class="p-4 border border-blue-500/20 rounded-lg bg-blue-500/10 hover:bg-blue-500/20 transition-colors text-center">
                        <div class="text-blue-400 font-medium">View Game</div>
                        <div class="text-xs text-gray-400 mt-1">See current details</div>
                    </a>
                    <a href="{{ path('game_index') }}" class="p-4 border border-[#D4AF37]/20 rounded-lg bg-[#D4AF37]/10 hover:bg-[#D4AF37]/20 transition-colors text-center">
                        <div class="text-[#D4AF37] font-medium">All Games</div>
                        <div class="text-xs text-gray-400 mt-1">Back to list</div>
                    </a>
                    <form method="post" action="{{ path('game_delete', {id: game.getGameId()}) }}" onsubmit="return confirm('Are you sure you want to delete this game? This action cannot be undone.');" class="contents">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ game.getGameId()) }}">
                        <button type="submit" class="w-full p-4 border border-red-500/20 rounded-lg bg-red-500/10 hover:bg-red-500/20 transition-colors text-center cursor-pointer">
                            <div class="text-red-400 font-medium">Delete Game</div>
                            <div class="text-xs text-gray-400 mt-1">Remove permanently</div>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-[#D4AF37]/20 bg-[#0a0a0f] mt-16">
        <div class="container mx-auto px-4 py-8">
            <div class="text-center text-gray-400 text-sm">
                <p>&copy; 2026 CarthageGG. All rights reserved.</p>
                <p class="mt-2">Tunisia's Premier Esports Platform</p>
            </div>
        </div>
    </footer>

    <script>
        // Add focus styles to form elements
        document.addEventListener('DOMContentLoaded', function() {
            const formInputs = document.querySelectorAll('input, select, textarea');
            formInputs.forEach(input => {
                input.addEventListener('focus', function() {
                    this.parentElement.classList.add('ring-1', 'ring-[#D4AF37]');
                });
                input.addEventListener('blur', function() {
                    this.parentElement.classList.remove('ring-1', 'ring-[#D4AF37]');
                });
            });
        });
    </script>
</body>
</html>