{% extends 'base.html.twig' %}

{% block title %}Add News - Admin Dashboard{% endblock %}

{% block content %}
<div class="container mx-auto px-6 py-8 max-w-2xl">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-white">Add News</h1>
        <a href="{{ path('app_admin_dash_news') }}" class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded-lg font-bold hover:bg-[#B8941F] transition">Back to News</a>
    </div>

    <div class="bg-[#12121a] rounded-xl border border-[#D4AF37]/10 p-8">
        <form method="POST" enctype="multipart/form-data" class="space-y-6">
            
            <!-- Title -->
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">Title</label>
                <input type="text" name="news_type[titre]" required class="w-full px-3 py-2 bg-[#1a1a24] border border-[#D4AF37]/20 rounded-lg text-white focus:outline-none focus:border-[#D4AF37]">
            </div>

            <!-- Category -->
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">Category</label>
                <input type="text" name="news_type[categorie]" required class="w-full px-3 py-2 bg-[#1a1a24] border border-[#D4AF37]/20 rounded-lg text-white focus:outline-none focus:border-[#D4AF37]">
            </div>

            <!-- Content -->
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">Content</label>
                <textarea name="news_type[contenu]" required rows="10" class="w-full px-3 py-2 bg-[#1a1a24] border border-[#D4AF37]/20 rounded-lg text-white focus:outline-none focus:border-[#D4AF37]"></textarea>
            </div>

            <!-- Image -->
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">Upload Image (Optional)</label>
                <input type="file" name="news_type[image]" accept="image/*" class="w-full px-3 py-2 bg-[#1a1a24] border border-[#D4AF37]/20 rounded-lg text-white focus:outline-none focus:border-[#D4AF37]">
            </div>

            <!-- Buttons -->
            <div class="flex gap-3 justify-end pt-4">
                <a href="{{ path('app_admin_dash_news') }}" class="px-4 py-2 bg-gray-600/20 text-gray-400 rounded-lg hover:bg-gray-600/30 transition">Cancel</a>
                <button type="submit" class="px-6 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded-lg font-bold hover:bg-[#B8941F] transition">Create News</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
