<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Team Players - CarthageGG</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom styles to match CarthageGG theme */
        .btn-primary {
            background: linear-gradient(to right, #D4AF37, #B8941F);
            color: #0a0a0f;
        }
        .btn-primary:hover {
            opacity: 0.9;
        }
        .btn-secondary {
            background-color: #D4AF37/10;
            color: #D4AF37;
            border: 1px solid #D4AF37/20;
        }
        .btn-secondary:hover {
            background-color: #D4AF37/20;
        }
    </style>
</head>
<body class="bg-[#0a0a0f] text-[#e4e4e7] min-h-screen">
    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 border-b border-[#D4AF37]/20 bg-[#0a0a0f]/95 backdrop-blur-sm">
        <div class="container mx-auto px-4">
            <div class="flex h-16 items-center justify-between">
                <a href="{{ path('app_index') }}" class="flex items-center space-x-2">
                    <img src="{{ asset('assets/images/zz.png') }}" alt="CarthageGG Logo" class="h-14 w-14 rounded-lg shadow-lg object-cover">
                    <span class="text-2xl font-bold text-[#D4AF37]">Carthage</span>
                    <span class="text-2xl font-bold text-white">GG</span>
                </a>
                <div class="hidden md:flex items-center space-x-1">
                    <a href="{{ path('tournament_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Tournaments</a>
                    <a href="{{ path('team_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Teams</a>
                    <a href="{{ path('match_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Matches</a>
                    <a href="{{ path('match_player_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">MatchPlayer</a>
                    <a href="{{ path('team_player_index') }}" class="px-4 py-2 rounded-md bg-[#D4AF37]/20 text-[#D4AF37] hover:bg-[#D4AF37]/30">TeamPlayer</a>
                    <a href="{{ path('game_index') }}" class="px-4 py-2 rounded-md text-gray-300 hover:bg-[#1e1e2e]">Game</a>
                </div>
                <div class="flex items-center space-x-3">
                    <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-white px-4 py-2 text-sm font-medium">Login</a>
                    <a href="{{ path('app_dashboard') }}" class="px-4 py-2 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] text-sm font-medium">Dashboard</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-8">
        <!-- Header Section -->
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-4xl font-bold text-[#D4AF37] mb-2">Team Players Management</h1>
                    <p class="text-gray-400">Manage player assignments to teams</p>
                </div>
                <a href="{{ path('team_player_new') }}" class="inline-flex items-center px-6 py-3 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] font-medium hover:opacity-90 transition-opacity">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Create New Team Player
                </a>
            </div>
            <div class="mt-4">
                <a href="{{ path('app_index') }}" class="text-[#D4AF37] hover:underline flex items-center">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    Back to site
                </a>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="border border-[#D4AF37]/20 rounded-lg bg-[#12121a] p-6">
                <div class="flex items-center">
                    <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-[#D4AF37]/10 flex items-center justify-center">
                        <svg class="w-6 h-6 text-[#D4AF37]" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13-5.5a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-bold text-[#D4AF37]">{{ teamPlayers|length }}</h3>
                        <p class="text-sm text-gray-400">Total Assignments</p>
                    </div>
                </div>
            </div>

            <div class="border border-[#D4AF37]/20 rounded-lg bg-[#12121a] p-6">
                <div class="flex items-center">
                    <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-blue-500/10 flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-400" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-bold text-blue-400">
                            {% set uniqueTeams = [] %}
                            {% for tp in teamPlayers %}
                                {% if tp.getTeam() and tp.getTeam().getTeamName() not in uniqueTeams %}
                                    {% set uniqueTeams = uniqueTeams|merge([tp.getTeam().getTeamName()]) %}
                                {% endif %}
                            {% endfor %}
                            {{ uniqueTeams|length }}
                        </h3>
                        <p class="text-sm text-gray-400">Unique Teams</p>
                    </div>
                </div>
            </div>

            <div class="border border-[#D4AF37]/20 rounded-lg bg-[#12121a] p-6">
                <div class="flex items-center">
                    <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-green-500/10 flex items-center justify-center">
                        <svg class="w-6 h-6 text-green-400" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13-5.5a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-bold text-green-400">
                            {% set uniqueUsers = [] %}
                            {% for tp in teamPlayers %}
                                {% if tp.getUser() and tp.getUser().getUsername() not in uniqueUsers %}
                                    {% set uniqueUsers = uniqueUsers|merge([tp.getUser().getUsername()]) %}
                                {% endif %}
                            {% endfor %}
                            {{ uniqueUsers|length }}
                        </h3>
                        <p class="text-sm text-gray-400">Unique Players</p>
                    </div>
                </div>
            </div>

            <div class="border border-[#D4AF37]/20 rounded-lg bg-[#12121a] p-6">
                <div class="flex items-center">
                    <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-purple-500/10 flex items-center justify-center">
                        <svg class="w-6 h-6 text-purple-400" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-bold text-purple-400">
                            {% set playersPerTeam = {} %}
                            {% for tp in teamPlayers %}
                                {% if tp.getTeam() %}
                                    {% set teamName = tp.getTeam().getTeamName() %}
                                    {% set playersPerTeam = playersPerTeam|merge({(teamName): (playersPerTeam[teamName] ?? 0) + 1}) %}
                                {% endif %}
                            {% endfor %}
                            {% set maxPlayers = 0 %}
                            {% for team, count in playersPerTeam %}
                                {% if count > maxPlayers %}
                                    {% set maxPlayers = count %}
                                {% endif %}
                            {% endfor %}
                            {{ maxPlayers }}
                        </h3>
                        <p class="text-sm text-gray-400">Max Players per Team</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Team Players Table -->
        <div class="bg-[#12121a] border border-[#D4AF37]/20 rounded-lg overflow-hidden mb-8">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="bg-[#1a1a24] border-b border-[#D4AF37]/20">
                            <th class="py-4 px-6 text-left text-[#D4AF37] font-semibold">ID</th>
                            <th class="py-4 px-6 text-left text-[#D4AF37] font-semibold">Team</th>
                            <th class="py-4 px-6 text-left text-[#D4AF37] font-semibold">User</th>
                            <th class="py-4 px-6 text-left text-[#D4AF37] font-semibold">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for tp in teamPlayers %}
                        <tr class="border-b border-[#D4AF37]/10 hover:bg-[#1a1a24]/50 transition-colors">
                            <td class="py-4 px-6">
                                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-[#D4AF37]/10 text-[#D4AF37] font-bold">
                                    {{ tp.getId() }}
                                </span>
                            </td>
                            <td class="py-4 px-6">
                                {% if tp.getTeam() %}
                                    <div class="flex items-center">
                                        <div class="w-10 h-10 rounded-lg bg-[#D4AF37]/20 flex items-center justify-center mr-3">
                                            <svg class="w-5 h-5 text-[#D4AF37]" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                                            </svg>
                                        </div>
                                        <div>
                                            <div class="font-medium">{{ tp.getTeam().getTeamName() }}</div>
                                            <div class="text-xs text-gray-400">Team ID: {{ tp.getTeam().getTeamId() }}</div>
                                        </div>
                                    </div>
                                {% else %}
                                    <span class="text-gray-500 italic">No team</span>
                                {% endif %}
                            </td>
                            <td class="py-4 px-6">
                                {% if tp.getUser() %}
                                    <div class="flex items-center">
                                        <div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center mr-3">
                                            <svg class="w-5 h-5 text-blue-400" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13-5.5a4 4 0 11-8 0 4 4 0 018 0z"/>
                                            </svg>
                                        </div>
                                        <div>
                                            <div class="font-medium">{{ tp.getUser().getUsername() }}</div>
                                            <div class="text-xs text-gray-400">Player</div>
                                        </div>
                                    </div>
                                {% else %}
                                    <span class="text-gray-500 italic">No user</span>
                                {% endif %}
                            </td>
                            <td class="py-4 px-6">
                                <div class="flex items-center space-x-2">
                                    <a href="{{ path('team_player_show', {id: tp.getId()}) }}" 
                                       class="px-3 py-1 rounded-md bg-blue-500/20 text-blue-400 hover:bg-blue-500/30 text-sm font-medium transition-colors">
                                        Show
                                    </a>
                                    <a href="{{ path('team_player_edit', {id: tp.getId()}) }}" 
                                       class="px-3 py-1 rounded-md bg-[#D4AF37]/10 text-[#D4AF37] hover:bg-[#D4AF37]/20 text-sm font-medium transition-colors">
                                        Edit
                                    </a>
                                    <form method="post" action="{{ path('team_player_delete', {id: tp.getId()}) }}" 
                                          style="display:inline" 
                                          onsubmit="return confirm('Are you sure you want to delete this team player assignment?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tp.getId()) }}">
                                        <button type="submit" 
                                                class="px-3 py-1 rounded-md bg-red-500/20 text-red-400 hover:bg-red-500/30 text-sm font-medium transition-colors">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="py-8 px-6 text-center text-gray-400">
                                <div class="flex flex-col items-center justify-center">
                                    <svg class="w-12 h-12 text-gray-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    <p class="text-lg">No team players found</p>
                                    <p class="text-sm">Create your first team player assignment to get started</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Team Distribution -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <div class="bg-[#12121a] border border-[#D4AF37]/20 rounded-lg p-6">
                <h3 class="text-xl font-bold text-[#D4AF37] mb-4">📊 Team Distribution</h3>
                <div class="space-y-3">
                    {% set teamCounts = {} %}
                    {% for tp in teamPlayers %}
                        {% if tp.getTeam() %}
                            {% set teamName = tp.getTeam().getTeamName() %}
                            {% set teamCounts = teamCounts|merge({(teamName): (teamCounts[teamName] ?? 0) + 1}) %}
                        {% endif %}
                    {% endfor %}
                    
                    {% for teamName, count in teamCounts %}
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="w-8 h-8 rounded-lg bg-[#D4AF37]/20 flex items-center justify-center mr-3">
                                <svg class="w-4 h-4 text-[#D4AF37]" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                                </svg>
                            </div>
                            <span class="text-gray-300">{{ teamName }}</span>
                        </div>
                        <div class="flex items-center">
                            <div class="w-32 bg-gray-700 rounded-full h-2 mr-3 overflow-hidden">
                                <div class="bg-[#D4AF37] h-2 rounded-full" style="width: {{ (count / teamPlayers|length * 100)|round }}%"></div>
                            </div>
                            <span class="text-[#D4AF37] font-bold">{{ count }}</span>
                        </div>
                    </div>
                    {% else %}
                    <p class="text-gray-400 text-center">No team distribution data available</p>
                    {% endfor %}
                </div>
            </div>

            <div class="bg-[#12121a] border border-[#D4AF37]/20 rounded-lg p-6">
                <h3 class="text-xl font-bold text-[#D4AF37] mb-4">⚡ Quick Actions</h3>
                <div class="space-y-3">
                    <a href="{{ path('team_player_new') }}" class="flex items-center justify-center w-full px-4 py-3 rounded-md bg-gradient-to-r from-[#D4AF37] to-[#B8941F] text-[#0a0a0f] font-medium hover:opacity-90 transition-opacity">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Add New Team Player
                    </a>
                    <a href="{{ path('app_index') }}" class="flex items-center justify-center w-full px-4 py-3 rounded-md border-2 border-[#D4AF37] text-[#D4AF37] font-medium hover:bg-[#D4AF37]/10 transition-colors">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                        </svg>
                        Back to Home
                    </a>
                    <a href="{{ path('team_index') }}" class="flex items-center justify-center w-full px-4 py-3 rounded-md border border-[#D4AF37]/20 text-gray-300 hover:bg-[#1e1e2e] transition-colors">
                        View All Teams
                    </a>
                </div>
            </div>
        </div>

        <!-- Additional Information -->
        <div class="bg-[#12121a] border border-[#D4AF37]/20 rounded-lg p-6">
            <h3 class="text-xl font-bold text-[#D4AF37] mb-4">ℹ️ About Team Players</h3>
            <div class="grid md:grid-cols-2 gap-6">
                <div>
                    <h4 class="font-medium text-gray-300 mb-2">Team Composition</h4>
                    <p class="text-sm text-gray-400">
                        Team players represent the roster of a team. Each player can be assigned to one or more teams,
                        and teams can have multiple players. This assignment is crucial for tournament participation
                        and match organization.
                    </p>
                </div>
                <div>
                    <h4 class="font-medium text-gray-300 mb-2">Best Practices</h4>
                    <ul class="space-y-2 text-sm text-gray-400">
                        <li class="flex items-start">
                            <svg class="w-4 h-4 text-[#D4AF37] mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                            Keep team rosters updated throughout tournaments
                        </li>
                        <li class="flex items-start">
                            <svg class="w-4 h-4 text-[#D4AF37] mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                            Ensure players are only on one active team per tournament
                        </li>
                        <li class="flex items-start">
                            <svg class="w-4 h-4 text-[#D4AF37] mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                            Regularly update team assignments as players join or leave
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-[#D4AF37]/20 bg-[#0a0a0f] mt-16">
        <div class="container mx-auto px-4 py-8">
            <div class="text-center text-gray-400 text-sm">
                <p>&copy; 2026 CarthageGG. All rights reserved.</p>
                <p class="mt-2">Tunisia's Premier Esports Platform</p>
            </div>
        </div>
    </footer>

    <script>
        // Add confirmation for delete actions
        document.addEventListener('DOMContentLoaded', function() {
            const deleteForms = document.querySelectorAll('form[onsubmit*="confirm"]');
            deleteForms.forEach(form => {
                form.onsubmit = function(e) {
                    return confirm('Are you sure you want to delete this team player assignment? This action cannot be undone.');
                };
            });
        });
    </script>
</body>
</html>