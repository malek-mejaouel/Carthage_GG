<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Matches | CarthageGG</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="{{ asset('assets/styles/admin.css') }}">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-[#0a0a0f] text-[#e4e4e7]">
    {% include 'admin/_sidebar.html.twig' %}
    <div class="lg:ml-64 flex flex-col min-h-screen">
    <main class="flex-1 p-6">
    <div class="container mx-auto px-6 py-8">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-2xl font-bold text-white">Matches</h1>
            <a href="{{ path('app_admin_dashboard') }}" class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded-lg font-bold hover:bg-[#B8941F] transition">Back to Dashboard</a>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            <div class="lg:col-span-2 bg-[#12121a] rounded-xl border border-[#D4AF37]/10 p-6">
                <h3 class="text-lg font-bold text-white mb-4">Match Volume</h3>
                <div class="relative h-80">
                    <canvas id="matchesChart"></canvas>
                </div>
            </div>
            <div class="bg-[#12121a] rounded-xl border border-[#D4AF37]/10 p-6">
                <h3 class="text-lg font-bold text-white mb-4">Outcome Distribution</h3>
                <div class="relative h-64">
                    <canvas id="outcomeChart"></canvas>
                </div>
            </div>
        </div>
        <div class="bg-[#12121a] rounded-xl border border-[#D4AF37]/10 overflow-hidden">
            <div class="p-6 border-b border-[#D4AF37]/10 flex justify-between items-center">
                <h3 class="text-lg font-bold text-white">Matches Management</h3>
                <div class="flex gap-2">
                    <a href="{{ path('match_new') }}" class="px-4 py-2 bg-[#D4AF37] text-[#0a0a0f] rounded-lg text-sm font-bold hover:bg-[#B8941F] transition">Add Match</a>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-400">
                    <thead class="bg-[#1a1a24] text-[#D4AF37] uppercase font-bold text-xs">
                        <tr>
                            <th class="px-6 py-4">ID</th>
                            <th class="px-6 py-4">Team A</th>
                            <th class="px-6 py-4">Team B</th>
                            <th class="px-6 py-4">Date</th>
                            <th class="px-6 py-4 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#D4AF37]/10">
                        {% for match in matches %}
                            <tr class="table-row-hover transition">
                                <td class="px-6 py-4 font-medium text-white">{{ match.matchId }}</td>
                                <td class="px-6 py-4">{{ match.teamA ? match.teamA.teamName : 'TBD' }}</td>
                                <td class="px-6 py-4">{{ match.teamB ? match.teamB.teamName : 'TBD' }}</td>
                                <td class="px-6 py-4">{{ match.matchDate ? match.matchDate|date('Y-m-d H:i') : 'N/A' }}</td>
                                <td class="px-6 py-4 text-center">
                                    <a href="{{ path('match_edit', {id: match.matchId}) }}" class="text-blue-400 hover:text-blue-300 mr-3">Edit</a>
                                    <form method="post" action="{{ path('match_delete', {id: match.matchId}) }}" class="inline" onsubmit="return confirm('Delete this match?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ match.matchId) }}">
                                        <button type="submit" class="text-red-400 hover:text-red-300">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center opacity-60 py-6">No matches found</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    </main>
    </div>
    <script>
        const matchesCtx = document.getElementById('matchesChart');
        new Chart(matchesCtx, {
            type: 'line',
            data: {
                labels: ['W1', 'W2', 'W3', 'W4'],
                datasets: [{ label: 'Matches', data: [320, 410, 380, 450], borderColor: '#A855F7', backgroundColor: 'rgba(168,85,247,0.1)' }]
            },
            options: { scales: { x: { ticks: { color: '#9CA3AF' } }, y: { ticks: { color: '#9CA3AF' } } } }
        });
        const outcomeCtx = document.getElementById('outcomeChart');
        new Chart(outcomeCtx, {
            type: 'doughnut',
            data: {
                labels: ['Completed', 'Pending', 'Cancelled'],
                datasets: [{ data: [65, 25, 10], backgroundColor: ['#10B981', '#F59E0B', '#EF4444'] }]
            },
            options: { plugins: { legend: { labels: { color: '#e4e4e7' } } } }
        });
    </script>
</script>
<script src="{{ asset('assets/js/admin-dashboard.js') }}"></script>
</body>
</html>
